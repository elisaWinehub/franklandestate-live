

{% liquid
  assign sid = section.id
  assign raw_input = section.settings.google_maps_url | default: '' | strip

  assign extracted_iframe_src = ''
  if raw_input != ''
    assign raw_lc = raw_input | downcase
    if raw_lc contains '<iframe'
      if raw_input contains 'src="'
        assign extracted_iframe_src = raw_input | split: 'src="' | last | split: '"' | first | strip
      elsif raw_input contains "src='"
        assign extracted_iframe_src = raw_input | split: "src='" | last | split: "'" | first | strip
      endif
    endif
  endif

  assign candidate_url = extracted_iframe_src
  if candidate_url == ''
    assign candidate_url = raw_input | strip
  endif

  assign candidate_url = candidate_url | replace: '&amp;', '&'

  assign map_mode = 'invalid'
  assign embed_src = ''
  assign normal_maps_url = ''

  assign cand_lc = candidate_url | downcase | strip
  assign embed_ok = false
  if cand_lc contains '/maps/embed' and cand_lc contains 'google.'
    if cand_lc contains 'https://' or cand_lc contains 'http://'
      unless cand_lc contains 'javascript:'
        assign embed_ok = true
      endunless
    endif
  endif
  if embed_ok
    assign map_mode = 'embed'
    assign embed_src = candidate_url | strip
    if embed_src contains 'http://'
      assign embed_src = embed_src | replace: 'http://', 'https://'
    endif
  endif

  if map_mode != 'embed' and raw_input != ''
    assign check_lc = raw_input | downcase | strip
    unless check_lc contains '<iframe'
      if check_lc contains 'https://' or check_lc contains 'http://'
        unless check_lc contains '/maps/embed'
          assign is_maps_share = false
          if check_lc contains 'maps.app.goo.gl'
            assign is_maps_share = true
          elsif check_lc contains 'goo.gl/maps'
            assign is_maps_share = true
          elsif check_lc contains 'maps.google.'
            assign is_maps_share = true
          elsif check_lc contains 'google.com/maps/'
            assign is_maps_share = true
          endif
          if is_maps_share
            assign map_mode = 'link'
            assign normal_maps_url = raw_input | strip
            unless normal_maps_url contains 'https://'
              if normal_maps_url contains 'http://'
                assign normal_maps_url = normal_maps_url | replace: 'http://', 'https://'
              endif
            endunless
          endif
        endunless
      endif
    endunless
  endif

  assign map_h = section.settings.map_height | default: 600
  assign pt = section.settings.padding_top | default: 48
  assign pb = section.settings.padding_bottom | default: 48
  assign bg = section.settings.background_color | default: '#e9e9e2'
  assign container_max = section.settings.container_width | default: 1110
  assign section_full = true
  if section.settings.section_width == 'page_width'
    assign section_full = false
  endif

  assign show_card = false
  if section.settings.show_info_card
    if section.settings.heading != blank or section.settings.business_name != blank or section.settings.address != blank
      assign show_card = true
    endif
  endif

  assign placeholder_message = 'To display the map here, use Google Maps → Share → Embed a map → copy the iframe src URL.'
%}

<section
  class="fe-google-map-section fe-google-map-section--{{ sid }}"
  style="
    --fe-google-map-height: {{ map_h }}px;
    --fe-google-map-pt: {{ pt }}px;
    --fe-google-map-pb: {{ pb }}px;
    --fe-google-map-container: {{ container_max }}px;
    background-color: {{ bg }};
  "
>
  <div class="fe-google-map-section__shell{% unless section_full %} fe-google-map-section__shell--contained{% endunless %}">
    {% if section.settings.heading != blank %}
      {% unless show_card %}
        <h2 class="fe-google-map-section__section-heading">{{ section.settings.heading | escape }}</h2>
      {% endunless %}
    {% endif %}

    <div class="fe-google-map-section__frame">
      <div class="fe-google-map-section__map-wrap">
        {% if show_card %}
          <div class="fe-google-map-section__card fe-google-map-card">
            {% if section.settings.heading != blank %}
              <p class="fe-google-map-section__card-heading">{{ section.settings.heading | escape }}</p>
            {% endif %}
            {% if section.settings.business_name != blank %}
              <p class="fe-google-map-section__business">{{ section.settings.business_name | escape }}</p>
            {% endif %}
            {% if section.settings.address != blank %}
              <div class="fe-google-map-section__address rte">{{ section.settings.address }}</div>
            {% endif %}
          </div>
        {% endif %}

        <div class="fe-google-map-section__map">
          {% if map_mode == 'embed' %}
            <iframe
              class="fe-google-map-section__iframe"
              src="{{ embed_src }}"
              title="{{ section.settings.business_name | default: section.settings.heading | default: 'Google Map' | escape }}"
              width="100%"
              height="{{ map_h }}"
              style="border:0;"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          {% elsif map_mode == 'link' %}
            <div class="fe-google-map-section__fallback" role="region" aria-label="Google Maps">
              <a
                class="fe-google-map-section__maps-btn"
                href="{{ normal_maps_url }}"
                target="_blank"
                rel="noopener"
              >
                Open in Google Maps
              </a>
            </div>
          {% else %}
            <div class="fe-google-map-section__placeholder" role="status">
              {{ placeholder_message }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .fe-google-map-section {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--fe-google-map-pt, 48px);
    padding-bottom: var(--fe-google-map-pb, 48px);
    padding-inline: 0;
    margin: 0;
  }

  .fe-google-map-section__shell {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .fe-google-map-section__shell--contained {
    max-width: var(--fe-google-map-container, 1110px);
    padding-inline: clamp(18px, 4vw, 28px);
  }

  .fe-google-map-section__shell:not(.fe-google-map-section__shell--contained) .fe-google-map-section__section-heading {
    padding-inline: clamp(18px, 4vw, 28px);
  }

  .fe-google-map-section__section-heading {
    margin: 0 auto clamp(24px, 4vw, 40px);
    max-width: var(--fe-google-map-container, 1110px);
    box-sizing: border-box;
    font-family: eidetic-neo, serif;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.2;
    color: #32291a;
    text-align: center;
  }

  .fe-google-map-section__shell--contained .fe-google-map-section__section-heading {
    max-width: none;
    padding-inline: 0;
  }

  .fe-google-map-section__frame {
    width: 100%;
    margin: 0;
    box-sizing: border-box;
  }

  .fe-google-map-section__map-wrap {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .fe-google-map-section__map {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #dcdad3;
    min-height: var(--fe-google-map-height, 600px);
  }

  .fe-google-map-section__iframe {
    display: block;
    width: 100%;
    height: var(--fe-google-map-height, 600px);
    border: 0;
    vertical-align: top;
  }

  .fe-google-map-section__fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--fe-google-map-height, 600px);
    padding: clamp(24px, 5vw, 40px);
    box-sizing: border-box;
    background: linear-gradient(180deg, rgb(230 228 220) 0%, rgb(216 214 206) 100%);
  }

  .fe-google-map-section__maps-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 999px;
    border: 1px solid #32291a;
    background: #32291a;
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .fe-google-map-section__maps-btn:hover {
    background: #ffffff;
    color: #32291a;
  }

  .fe-google-map-section__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--fe-google-map-height, 600px);
    padding: clamp(20px, 4vw, 32px);
    margin-inline: clamp(0px, 2vw, 0px);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.65;
    color: rgb(50 41 26 / 72%);
    text-align: center;
    box-sizing: border-box;
    border: 1px dashed rgb(50 41 26 / 22%);
    background: rgb(255 255 255 / 35%);
  }

  .fe-google-map-section__card {
    box-sizing: border-box;
    background: #ffffff;
    border-radius: 10px;
    box-shadow: 0 12px 36px rgb(50 41 26 / 12%);
    padding: 24px 28px;
    border: 1px solid rgb(50 41 26 / 6%);
  }

  .fe-google-map-section__card-heading {
    margin: 0 0 10px;
    font-family: eidetic-neo, serif;
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 400;
    line-height: 1.2;
    color: #32291a;
  }

  .fe-google-map-section__card-heading:last-child {
    margin-bottom: 0;
  }

  .fe-google-map-section__business {
    margin: 0 0 12px;
    font-family: eidetic-neo, serif;
    font-size: clamp(26px, 2.5vw, 32px);
    font-weight: 400;
    line-height: 1.2;
    color: #32291a;
  }

  .fe-google-map-section__card .fe-google-map-section__business:last-child {
    margin-bottom: 0;
  }

  .fe-google-map-section__address {
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.65;
    color: #2e261d;
  }

  .fe-google-map-section__address p {
    margin: 0 0 0.65em;
  }

  .fe-google-map-section__address p:last-child {
    margin-bottom: 0;
  }

  .fe-google-map-section__address a {
    color: #32291a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media screen and (min-width: 750px) {
    .fe-google-map-section__map-wrap {
      min-height: var(--fe-google-map-height, 600px);
    }

    .fe-google-map-section .fe-google-map-card {
      position: absolute;
      top: 24px;
      left: 24px;
      max-width: 360px;
      z-index: 2;
    }

    .fe-google-map-section__iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .fe-google-map-section__fallback,
    .fe-google-map-section__placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-height: 0;
    }

    .fe-google-map-section__fallback {
      background: linear-gradient(180deg, rgb(230 228 220) 0%, rgb(216 214 206) 100%);
    }

    .fe-google-map-section__placeholder {
      margin-inline: 0;
      border-left: 0;
      border-right: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .fe-google-map-section__map-wrap {
      display: flex;
      flex-direction: column;
      gap: clamp(16px, 4vw, 22px);
    }

    .fe-google-map-section__card {
      position: relative;
      order: -1;
      max-width: none;
      margin-inline: 0;
      align-self: stretch;
    }

    .fe-google-map-section__shell:not(.fe-google-map-section__shell--contained) .fe-google-map-section__card {
      margin-inline: clamp(18px, 4vw, 24px);
    }

    .fe-google-map-section__map {
      min-height: 0;
    }

    .fe-google-map-section__iframe {
      height: var(--fe-google-map-height, 600px);
      min-height: 280px;
      position: relative;
    }

    .fe-google-map-section__fallback {
      min-height: var(--fe-google-map-height, 600px);
    }

    .fe-google-map-section__placeholder {
      min-height: var(--fe-google-map-height, 600px);
      margin-inline: 0;
    }

    .fe-google-map-section__shell:not(.fe-google-map-section__shell--contained) .fe-google-map-section__map .fe-google-map-section__placeholder,
    .fe-google-map-section__shell:not(.fe-google-map-section__shell--contained) .fe-google-map-section__map .fe-google-map-section__fallback {
      margin-inline: clamp(18px, 4vw, 24px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Google Map",
  "tag": "section",
  "class": "fe-google-map-section-root",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Google Map"
    },
    {
      "type": "text",
      "id": "business_name",
      "label": "Business name",
      "default": "Frankland Estate"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "textarea",
      "id": "google_maps_url",
      "label": "Google Maps URL or embed URL",
      "info": "Paste either the iframe src URL from Google Maps Embed a map, full iframe HTML, or a normal Google Maps link."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "page_width",
          "label": "Page width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 900,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "default": 1110
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#e9e9e2"
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Map height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "show_info_card",
      "label": "Show info card",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Google Map"
    }
  ]
}
{% endschema %}
