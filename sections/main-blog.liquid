

{% liquid
  assign per_page = section.settings.posts_per_page | default: 8
  assign excerpt_len = section.settings.excerpt_max_chars | default: 160
  assign bg = section.settings.background_color | default: '#E9E8E2'
  assign max_w = section.settings.container_max_width | default: 1200
  assign pad_top = section.settings.padding_top | default: 0
  assign pad_bottom = section.settings.padding_bottom | default: 0
%}

<div
  class="fe-blog-template fe-blog-template--{{ section.id }}"
  style="
    --fe-blog-bg: {{ bg }};
    --fe-blog-max: {{ max_w }}px;
    --fe-blog-pad-top: {{ pad_top }}px;
    --fe-blog-pad-bottom: {{ pad_bottom }}px;
  "
>
  <div class="fe-blog-template__surface">
    <div class="fe-blog-template__inner">
      {% if section.settings.listing_heading != blank %}
        <h1 class="fe-blog-template__masthead">{{ section.settings.listing_heading | escape }}</h1>
      {% endif %}

      {% paginate blog.articles by per_page %}
        <div class="fe-blog-template__list">
          {% for article in blog.articles %}
            <article class="fe-blog-template__row">
              <a href="{{ article.url }}" class="fe-blog-template__media-link">
                <span class="fe-blog-template__media">
                  {% if article.image != blank %}
                    {% liquid
                      assign img_alt = article.image.alt | default: article.title
                    %}
                    {{
                      article.image
                      | image_url: width: 1400
                      | image_tag:
                        alt: img_alt,
                        class: 'fe-blog-template__img',
                        loading: 'lazy',
                        sizes: '(min-width: 750px) 38vw, 100vw',
                        widths: '400,550,700,900,1100,1400'
                    }}
                  {% else %}
                    {{ 'hero-apparel-3' | placeholder_svg_tag: 'fe-blog-template__img fe-blog-template__img--placeholder' }}
                  {% endif %}
                </span>
              </a>

              <div class="fe-blog-template__content">
                <h2 class="fe-blog-template__title">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h2>
                {% liquid
                  assign excerpt_src = article.excerpt_or_content | strip_html
                  assign excerpt_text = excerpt_src | truncate: excerpt_len
                %}
                {% if excerpt_text != blank %}
                  <p class="fe-blog-template__excerpt">{{ excerpt_text }}</p>
                {% endif %}
                <div class="fe-blog-template__meta">
                  <span class="fe-blog-template__date-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
                      <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                      <path d="M16 2v4M8 2v4M3 10h18"></path>
                    </svg>
                  </span>
                  <time class="fe-blog-template__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    {{- article.published_at | date: '%B %e, %Y' -}}
                  </time>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="fe-blog-template__pagination">
            {% render 'pagination-controls', paginate: paginate %}
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</div>

{% stylesheet %}
  .fe-blog-template {
    background: var(--fe-blog-bg, #e9e8e2);
    width: 100%;
    box-sizing: border-box;
  }

  .fe-blog-template__surface {
    padding-top: calc(clamp(48px, 8vw, 96px) + var(--fe-blog-pad-top, 0px));
    padding-bottom: calc(clamp(48px, 8vw, 96px) + var(--fe-blog-pad-bottom, 0px));
    box-sizing: border-box;
  }

  .fe-blog-template__inner {
    width: 100%;
    max-width: var(--fe-blog-max, 1200px);
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 28px);
    box-sizing: border-box;
  }

  .fe-blog-template__masthead {
    text-align: center;
    font-family: eidetic-neo, serif;
    font-weight: 400;
    font-size: clamp(28px, 3.5vw, 40px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #32291a;
    margin: 0 0 clamp(40px, 6vw, 72px);
    line-height: 1.2;
  }

  .fe-blog-template__list {
    display: flex;
    flex-direction: column;
  }

  .fe-blog-template__row {
    display: grid;
    grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: start;
    padding-block: clamp(32px, 5vw, 56px);
    border-bottom: 1px solid rgb(50 41 26 / 14%);
    box-sizing: border-box;
  }

  .fe-blog-template__row:last-child {
    border-bottom: none;
  }

  .fe-blog-template__media-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .fe-blog-template__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(50 41 26 / 6%);
  }

  .fe-blog-template__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    vertical-align: middle;
  }

  .fe-blog-template__img--placeholder {
    object-fit: contain;
    padding: 14%;
    opacity: 0.45;
    height: 100%;
  }

  .fe-blog-template__content {
    padding-top: 4px;
    box-sizing: border-box;
  }

  .fe-blog-template__title {
    margin: 0 0 14px;
    font-family: eidetic-neo, serif;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 400;
    line-height: 1.28;
  }

  .fe-blog-template__title a {
    color: #32291a;
    text-decoration: none;
  }

  .fe-blog-template__title a:hover {
    text-decoration: underline;
  }

  .fe-blog-template__excerpt {
    margin: 0 0 18px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.7;
    color: #32291a;
    max-width: 62ch;
  }

  .fe-blog-template__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    color: rgb(50 41 26 / 62%);
  }

  .fe-blog-template__date-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: rgb(50 41 26 / 55%);
  }

  .fe-blog-template__date {
    font-weight: 400;
  }

  .fe-blog-template__pagination {
    margin-top: clamp(36px, 6vw, 64px);
  }

  .fe-blog-template__pagination .pagination {
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .fe-blog-template__row {
      grid-template-columns: 1fr;
      padding-block: clamp(28px, 7vw, 44px);
    }

    .fe-blog-template__media {
      aspect-ratio: 16 / 10;
      max-height: 280px;
    }

    .fe-blog-template__title {
      font-size: clamp(20px, 5vw, 24px);
    }

    .fe-blog-template__excerpt {
      font-size: 14px;
      max-width: none;
    }

    .fe-blog-template__masthead {
      letter-spacing: 0.1em;
      margin-bottom: clamp(28px, 8vw, 44px);
      font-size: clamp(24px, 6vw, 32px);
    }

    .fe-blog-template__meta {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog (Frankland)",
  "tag": "section",
  "class": "fe-blog-main-section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "text",
      "id": "listing_heading",
      "label": "Listing heading",
      "default": "Blog"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per page",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "excerpt_max_chars",
      "label": "Excerpt length (characters)",
      "min": 140,
      "max": 180,
      "step": 5,
      "default": 160
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#E9E8E2"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Content max width",
      "min": 960,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Extra top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Extra bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
