{%- liquid
  assign sid = section.id
  assign maxw = section.settings.container_width | default: 1110
  assign media_mode = section.settings.media_mode | default: 'gallery'
  assign gallery_slide_count = 0
  for block in section.blocks
    if block.type == 'gallery_image' and block.settings.image != blank
      assign gallery_slide_count = gallery_slide_count | plus: 1
    endif
  endfor

  assign show_gallery = false
  assign show_single = false
  if media_mode == 'single' and section.settings.single_image != blank
    assign show_single = true
  elsif media_mode == 'gallery' and gallery_slide_count > 0
    assign show_gallery = true
  endif
  assign show_media_col = false
  if show_gallery or show_single
    assign show_media_col = true
  endif
-%}

<section
  id="{{ section.settings.section_id | default: 'where-we-live' | handleize }}"
  class="fe-about-where fe-about-where--{{ sid }}"
  style="
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="fe-about-where__inner" style="max-width: {{ maxw }}px;">
    <div class="fe-about-where__cols{% unless show_media_col %} fe-about-where__cols--no-gallery{% endunless %}">
      <div class="fe-about-where__main">
        {%- if section.settings.section_number != blank -%}
          <p class="fe-about-where__eyebrow">{{ section.settings.section_number | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="fe-about-where__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="fe-about-where__body rte">{{ section.settings.body }}</div>
        {%- endif -%}

        <div class="fe-about-where__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <div class="fe-about-where__feature" {{ block.shopify_attributes }}>
                <div class="fe-about-where__feature-icon-wrap">
                  {%- if block.settings.icon_image != blank -%}
                    <img
                      class="fe-about-where__feature-icon"
                      src="{{ block.settings.icon_image | image_url: width: 120 }}"
                      alt="{{ block.settings.icon_alt | escape | default: block.settings.title }}"
                      loading="lazy"
                      width="48"
                      height="48"
                    >
                  {%- elsif block.settings.icon_svg != blank -%}
                    <div class="fe-about-where__feature-svg">{{ block.settings.icon_svg }}</div>
                  {%- else -%}
                    {%- assign feat_title = block.settings.title | downcase -%}
                    <div class="fe-about-where__feature-svg fe-about-where__feature-svg--default" aria-hidden="true">
                      {%- if feat_title contains 'ocean' or feat_title contains 'coast' or feat_title contains 'sea' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M6 30q6-5 12 0t12 0 12 0"/><path d="M6 36q6-5 12 0t12 0 12 0"/><path d="M6 24q6-5 12 0t12 0 12 0"/></svg>
                      {%- elsif feat_title contains 'organic' or feat_title contains 'leaf' or feat_title contains 'certified' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M24 40c10-8 14-22 2-32-9 10-6 24 2 32z"/><path d="M24 40c-8-6-12-18-4-26"/></svg>
                      {%- elsif feat_title contains 'premium' or feat_title contains 'region' or feat_title contains 'frankland' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><circle cx="24" cy="22" r="9"/><path d="M24 9v4M24 31v4M11 22h4M33 22h4M14 13l3 3M31 13l-3 3M14 31l3-3M31 31l-3-3"/></svg>
                      {%- else -%}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M8 38 22 14l6 8 12-20 4 36z"/><path d="m14 38 10-14 6 6 10-12"/></svg>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
                <div class="fe-about-where__feature-copy">
                  {%- if block.settings.title != blank -%}
                    <h3 class="fe-about-where__feature-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="fe-about-where__feature-desc">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if show_single -%}
        <div
          class="fe-about-where__single"
          style="--fe-aw-single-fit: {{ section.settings.single_image_fit | default: 'contain' }};"
        >
          <figure class="fe-about-where__single-inner">
            <img
              class="fe-about-where__single-img"
              src="{{ section.settings.single_image | image_url: width: 1600 }}"
              srcset="
                {{ section.settings.single_image | image_url: width: 700 }} 700w,
                {{ section.settings.single_image | image_url: width: 1100 }} 1100w,
                {{ section.settings.single_image | image_url: width: 1600 }} 1600w
              "
              sizes="(max-width: 989px) 100vw, 45vw"
              alt="{{ section.settings.single_image_alt | escape | default: section.settings.heading }}"
              width="{{ section.settings.single_image.width }}"
              height="{{ section.settings.single_image.height }}"
              loading="lazy"
            >
          </figure>
        </div>
      {%- elsif show_gallery -%}
        <div class="fe-about-where__gallery fe-about-where__gallery--carousel" data-fe-about-where-carousel="{{ sid }}" id="fe-about-where-carousel-{{ sid }}">
          <div class="fe-about-where__gallery-stage-shell">
            <div class="fe-about-where__gallery-stage" aria-live="polite">
              {%- assign si = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
                  <figure
                    id="fe-about-where-slide-{{ sid }}-{{ si }}"
                    class="fe-about-where__gallery-slide{% if si == 0 %} is-active{% endif %}"
                    data-slide-index="{{ si }}"
                    data-fe-about-where-full-src="{{ block.settings.image | image_url: width: 2800 }}"
                    data-fe-about-where-alt="{{ block.settings.alt | escape | default: section.settings.heading }}"
                    {% if gallery_slide_count > 1 %}role="tabpanel" aria-labelledby="fe-about-where-tab-{{ sid }}-{{ si }}"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <img
                      class="fe-about-where__gallery-img fe-about-where__gallery-img--main"
                      src="{{ block.settings.image | image_url: width: 1600 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 700 }} 700w,
                        {{ block.settings.image | image_url: width: 1100 }} 1100w,
                        {{ block.settings.image | image_url: width: 1600 }} 1600w
                      "
                      sizes="(max-width: 989px) 100vw, 45vw"
                      alt="{{ block.settings.alt | escape | default: section.settings.heading }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="{% if si == 0 %}eager{% else %}lazy{% endif %}"
                      tabindex="0"
                      role="button"
                      aria-label="{{ 'accessibility.view_full_size' | t | default: 'View full size image' }}"
                    >
                  </figure>
                  {%- assign si = si | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if gallery_slide_count > 1 -%}
              <div class="fe-about-where__gallery-arrows">
                <button
                  type="button"
                  class="fe-about-where__gallery-arrow fe-about-where__gallery-arrow--prev"
                  data-fe-about-where-prev
                  aria-controls="fe-about-where-carousel-{{ sid }}"
                  aria-label="{{ 'general.pagination.previous' | t | default: 'Previous image' }}"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button
                  type="button"
                  class="fe-about-where__gallery-arrow fe-about-where__gallery-arrow--next"
                  data-fe-about-where-next
                  aria-controls="fe-about-where-carousel-{{ sid }}"
                  aria-label="{{ 'general.pagination.next' | t | default: 'Next image' }}"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                    <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          </div>

          {%- if gallery_slide_count > 1 -%}
            <div class="fe-about-where__gallery-thumbs-shell">
              <button
                type="button"
                class="fe-about-where__gallery-thumbs-arrow fe-about-where__gallery-thumbs-arrow--prev"
                data-fe-about-where-thumbs-prev
                aria-label="{{ 'general.pagination.previous' | t | default: 'Previous thumbnails' }}"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="fe-about-where__gallery-thumbs-track" data-fe-about-where-thumbs-track>
                <div class="fe-about-where__gallery-thumbs" role="tablist" aria-label="Gallery thumbnails">
                  {%- assign ti = 0 -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
                      <button
                        type="button"
                        class="fe-about-where__gallery-thumb{% if ti == 0 %} is-active{% endif %}"
                        role="tab"
                        aria-selected="{% if ti == 0 %}true{% else %}false{% endif %}"
                        aria-controls="fe-about-where-slide-{{ sid }}-{{ ti }}"
                        id="fe-about-where-tab-{{ sid }}-{{ ti }}"
                        data-fe-about-where-slide-to="{{ ti }}"
                      >
                        <span class="visually-hidden">Gallery image {{ ti | plus: 1 }}</span>
                        <img
                          src="{{ block.settings.image | image_url: width: 180 }}"
                          alt=""
                          loading="lazy"
                          width="72"
                          height="72"
                        >
                      </button>
                      {%- assign ti = ti | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
              <button
                type="button"
                class="fe-about-where__gallery-thumbs-arrow fe-about-where__gallery-thumbs-arrow--next"
                data-fe-about-where-thumbs-next
                aria-label="{{ 'general.pagination.next' | t | default: 'Next thumbnails' }}"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {%- endif -%}

          <div
            class="fe-about-where__lightbox"
            hidden
            data-fe-about-where-lightbox
            aria-hidden="true"
          >
            <div class="fe-about-where__lightbox-backdrop" data-fe-about-where-lightbox-close tabindex="-1"></div>
            <div
              class="fe-about-where__lightbox-panel"
              role="dialog"
              aria-modal="true"
              aria-label="{{ 'accessibility.enlarged_image' | t | default: 'Enlarged gallery image' }}"
            >
              <button
                type="button"
                class="fe-about-where__lightbox-close"
                data-fe-about-where-lightbox-close
                aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              </button>
              <button
                type="button"
                class="fe-about-where__lightbox-nav fe-about-where__lightbox-nav--prev"
                data-fe-about-where-lightbox-prev
                aria-label="{{ 'general.pagination.previous' | t | default: 'Previous image' }}"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="fe-about-where__lightbox-img-wrap">
                <img class="fe-about-where__lightbox-img" data-fe-about-where-lightbox-img src="" alt="">
              </div>
              <button
                type="button"
                class="fe-about-where__lightbox-nav fe-about-where__lightbox-nav--next"
                data-fe-about-where-lightbox-next
                aria-label="{{ 'general.pagination.next' | t | default: 'Next image' }}"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .fe-about-where--{{ sid }} {
    color: {{ section.settings.text_color }};
    box-sizing: border-box;
  }

  .fe-about-where--{{ sid }} .fe-about-where__inner {
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .fe-about-where--{{ sid }} .fe-about-where__cols--no-gallery {
    grid-template-columns: 1fr;
  }

  .fe-about-where--{{ sid }} .fe-about-where__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 48px);
    align-items: stretch;
  }

  .fe-about-where--{{ sid }} .fe-about-where__main {
    min-width: 0;
  }

  .fe-about-where--{{ sid }} .fe-about-where__single {
    min-width: 0;
    height: 100%;
    display: flex;
  }

  .fe-about-where--{{ sid }} .fe-about-where__single-inner {
    flex: 1;
    width: 100%;
    margin: 0;
    min-height: 280px;
    background: rgba(48, 35, 19, 0.06);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fe-about-where--{{ sid }} .fe-about-where__single-img {
    width: 100%;
    height: 100%;
    object-fit: var(--fe-aw-single-fit, contain);
    object-position: center top;
    display: block;
  }

  .fe-about-where--{{ sid }} .fe-about-where__eyebrow {
    margin: 0 0 10px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .fe-about-where--{{ sid }} .fe-about-where__heading {
    margin: 0;
    font-family: eidetic-neo, Georgia, "Times New Roman", serif;
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 400;
    line-height: 1.12;
  }

  .fe-about-where--{{ sid }} .fe-about-where__body {
    margin: 18px 0 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    line-height: 1.65;
    opacity: 0.92;
    max-width: 520px;
  }

  .fe-about-where--{{ sid }} .fe-about-where__body p {
    margin: 0;
  }

  .fe-about-where--{{ sid }} .fe-about-where__body p + p {
    margin-top: 12px;
  }

  .fe-about-where--{{ sid }} .fe-about-where__features {
    margin-top: 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px 16px;
    padding: 22px 18px 22px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
    border-right: 1px solid {{ section.settings.divider_color }};
    box-sizing: border-box;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature:nth-child(2n) {
    padding-left: 18px;
    padding-right: 0;
    border-right: 0;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature-icon-wrap {
    width: 48px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature-icon {
    width: 48px;
    height: 48px;
    object-fit: contain;
    display: block;
    opacity: 0.85;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature-svg {
    width: 48px;
    color: inherit;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature-svg svg {
    width: 48px;
    height: auto;
    display: block;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature-copy {
    min-width: 0;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature-title {
    margin: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .fe-about-where--{{ sid }} .fe-about-where__feature-desc {
    margin: 8px 0 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.82;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-stage-shell {
    position: relative;
    width: 100%;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: rgba(48, 35, 19, 0.06);
    overflow: hidden;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    line-height: 0;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-img--main {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    vertical-align: middle;
    cursor: pointer;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-arrows {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6px;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-arrow {
    pointer-events: auto;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #ffffff;
    background: rgba(48, 35, 19, 0.42);
    backdrop-filter: blur(4px);
    transition: background 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-arrow:hover {
    background: rgba(48, 35, 19, 0.62);
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-arrow:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .fe-about-where--{{ sid }} .fe-about-where__gallery-arrows {
      opacity: 0;
    }

    .fe-about-where--{{ sid }} .fe-about-where__gallery-stage-shell:hover .fe-about-where__gallery-arrows,
    .fe-about-where--{{ sid }} .fe-about-where__gallery-stage-shell:focus-within .fe-about-where__gallery-arrows {
      opacity: 1;
    }
  }

  @media (hover: none) {
    .fe-about-where--{{ sid }} .fe-about-where__gallery-arrows {
      opacity: 1;
    }
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumbs-shell {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 0;
    min-width: 0;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumbs-arrow {
    align-self: stretch;
    width: 38px;
    min-width: 38px;
    border: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: {{ section.settings.text_color }};
    background: rgba(255, 255, 255, 0.65);
    opacity: 1;
    transition: background 0.2s ease, opacity 0.25s ease;
    z-index: 2;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumbs-arrow:hover {
    background: rgba(255, 255, 255, 0.92);
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumbs-arrow:focus-visible {
    outline: 2px solid {{ section.settings.text_color }};
    outline-offset: 2px;
    opacity: 1;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumbs-track {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumbs-track::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumbs {
    display: flex;
    flex-flow: row nowrap;
    align-items: stretch;
    gap: 10px;
    width: max-content;
    padding: 4px 2px;
    box-sizing: border-box;
  }

  .fe-about-where--{{ sid }} .fe-about-where__gallery-thumb {
    flex: 0 0 auto;
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    box-sizing: border-box;
    opacity: 0.72;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

