<script>
  (function () {
    var roots = document.querySelectorAll('[data-fe-about-where-carousel]');
    roots.forEach(function (root) {
      var slides = root.querySelectorAll('.fe-about-where__gallery-slide');
      var thumbs = root.querySelectorAll('.fe-about-where__gallery-thumb');
      var thumbsTrack = root.querySelector('[data-fe-about-where-thumbs-track]');
      var btnPrev = root.querySelector('[data-fe-about-where-prev]');
      var btnNext = root.querySelector('[data-fe-about-where-next]');
      var btnThumbsPrev = root.querySelector('[data-fe-about-where-thumbs-prev]');
      var btnThumbsNext = root.querySelector('[data-fe-about-where-thumbs-next]');

      var lightbox = root.querySelector('[data-fe-about-where-lightbox]');
      var lbImg = root.querySelector('[data-fe-about-where-lightbox-img]');
      var lbPrev = root.querySelector('[data-fe-about-where-lightbox-prev]');
      var lbNext = root.querySelector('[data-fe-about-where-lightbox-next]');
      var lbCloseEls = root.querySelectorAll('[data-fe-about-where-lightbox-close]');

      if (!slides.length) return;

      var reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var lbIndex = 0;
      var lastFocused = null;
      var lbFadeCleanup = null;
      var lbAnimGen = 0;

      function cancelLbFade() {
        if (typeof lbFadeCleanup === 'function') {
          lbFadeCleanup();
          lbFadeCleanup = null;
        }
        if (lbImg) {
          lbImg.onload = null;
          lbImg.onerror = null;
          lbImg.style.opacity = '1';
        }
        lbAnimGen++;
      }

      function activeIndex() {
        var n = slides.length;
        for (var k = 0; k < n; k++) {
          if (slides[k].classList.contains('is-active')) return k;
        }
        return 0;
      }

      function scrollThumbIntoView(i) {
        if (!thumbs.length || i < 0 || i >= thumbs.length) return;
        thumbs[i].scrollIntoView({
          inline: 'nearest',
          block: 'nearest',
          behavior: reduceMotion ? 'auto' : 'smooth'
        });
      }

      function thumbsScroll(direction) {
        if (!thumbsTrack) return;
        var delta = Math.max(160, thumbsTrack.clientWidth * 0.55) * direction;
        thumbsTrack.scrollBy({ left: delta, behavior: reduceMotion ? 'auto' : 'smooth' });
      }

      function go(rawIndex) {
        var n = slides.length;
        var i = parseInt(rawIndex, 10);
        if (isNaN(i)) return;
        i = ((i % n) + n) % n;
        slides.forEach(function (slide, idx) {
          slide.classList.toggle('is-active', idx === i);
        });
        thumbs.forEach(function (btn, idx) {
          var on = idx === i;
          btn.classList.toggle('is-active', on);
          btn.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        scrollThumbIntoView(i);
      }

      thumbs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          go(btn.getAttribute('data-fe-about-where-slide-to'));
        });
      });

      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          go(activeIndex() - 1);
        });
      }
      if (btnNext) {
        btnNext.addEventListener('click', function () {
          go(activeIndex() + 1);
        });
      }

      if (btnThumbsPrev) {
        btnThumbsPrev.addEventListener('click', function () {
          thumbsScroll(-1);
        });
      }
      if (btnThumbsNext) {
        btnThumbsNext.addEventListener('click', function () {
          thumbsScroll(1);
        });
      }

      function slideFullAt(i) {
        var slide = slides[i];
        if (!slide) return { src: '', alt: '' };
        return {
          src: slide.getAttribute('data-fe-about-where-full-src') || '',
          alt: slide.getAttribute('data-fe-about-where-alt') || ''
        };
      }

      function syncLightboxImage(animate) {
        if (!lbImg) return;
        var d = slideFullAt(lbIndex);
        if (!d.src) return;

        cancelLbFade();
        var gen = lbAnimGen;

        function applyAndFadeIn() {
          if (gen !== lbAnimGen) return;
          lbImg.src = d.src;
          lbImg.alt = d.alt;
          function reveal() {
            if (gen !== lbAnimGen) return;
            lbImg.style.opacity = '1';
          }
          if (lbImg.complete) {
            requestAnimationFrame(reveal);
          } else {
            lbImg.onload = function () {
              lbImg.onload = null;
              if (gen !== lbAnimGen) return;
              requestAnimationFrame(reveal);
            };
            lbImg.onerror = function () {
              lbImg.onerror = null;
              if (gen !== lbAnimGen) return;
              requestAnimationFrame(reveal);
            };
          }
        }

        if (!animate || reduceMotion) {
          lbImg.style.opacity = '1';
          lbImg.src = d.src;
          lbImg.alt = d.alt;
          return;
        }

        var finishedOut = false;
        var fallbackTimer = null;

        function finishFadeOut(e) {
          if (finishedOut) return;
          if (gen !== lbAnimGen) return;
          if (e && e.propertyName !== 'opacity') return;
          finishedOut = true;
          clearTimeout(fallbackTimer);
          lbImg.removeEventListener('transitionend', finishFadeOut);
          lbFadeCleanup = null;
          applyAndFadeIn();
        }

        lbFadeCleanup = function () {
          finishedOut = true;
          clearTimeout(fallbackTimer);
          lbImg.removeEventListener('transitionend', finishFadeOut);
        };

        lbImg.style.opacity = '0';
        lbImg.addEventListener('transitionend', finishFadeOut);
        fallbackTimer = window.setTimeout(finishFadeOut, 500);
      }

      function lbOnDocKeydown(e) {
        if (!lightbox || lightbox.hasAttribute('hidden')) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeLightbox();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          lightboxStep(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          lightboxStep(1);
        }
      }

      function openLightbox(rawIndex) {
        if (!lightbox || !lbImg) return;
        var n = slides.length;
        var i = parseInt(rawIndex, 10);
        if (isNaN(i)) i = activeIndex();
        lbIndex = ((i % n) + n) % n;
        syncLightboxImage(false);
        lastFocused = document.activeElement;
        lightbox.removeAttribute('hidden');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        document.addEventListener('keydown', lbOnDocKeydown);
        var closeBtn = root.querySelector('.fe-about-where__lightbox-close');
        if (closeBtn && typeof closeBtn.focus === 'function') closeBtn.focus();
      }

      function closeLightbox() {
        if (!lightbox || lightbox.hasAttribute('hidden')) return;
        document.removeEventListener('keydown', lbOnDocKeydown);
        cancelLbFade();
        lightbox.setAttribute('hidden', '');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lbImg) lbImg.style.opacity = '1';
        if (lastFocused && typeof lastFocused.focus === 'function') {
          try {
            lastFocused.focus();
          } catch (err) {}
        }
      }

      function lightboxStep(delta) {
        var n = slides.length;
        lbIndex = (lbIndex + delta + n) % n;
        syncLightboxImage(true);
      }

      slides.forEach(function (slide, idx) {
        var img = slide.querySelector('.fe-about-where__gallery-img--main');
        if (!img) return;
        img.addEventListener('click', function (e) {
          e.preventDefault();
          openLightbox(idx);
        });
        img.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openLightbox(idx);
          }
        });
      });

      if (lbPrev) {
        lbPrev.addEventListener('click', function () {
          lightboxStep(-1);
        });
      }
      if (lbNext) {
        lbNext.addEventListener('click', function () {
          lightboxStep(1);
        });
      }
      lbCloseEls.forEach(function (el) {
        el.addEventListener('click', closeLightbox);
      });
    });
  })();
</script>

