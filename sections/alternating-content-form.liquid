{%- liquid
  assign sid = section.id
  assign cil_scope = 'fe-alternating-content-form--' | append: sid
  assign position = section.settings.content_position | default: 'content_left'
  assign form_mode = section.settings.form_mode | default: 'static'
  assign content_fs = section.settings.content_font_size | default: 16
  assign heading_fs_max = section.settings.heading_font_size | default: 40
  assign heading_fs_min = heading_fs_max | minus: 14
  if heading_fs_min < 22
    assign heading_fs_min = 22
  endif
  assign heading_ff = section.settings.heading_font_family | default: 'eidetic_neo'
  assign heading_font_family_css = 'eidetic-neo, Georgia, "Times New Roman", serif'
  case heading_ff
    when 'plus_jakarta'
      assign heading_font_family_css = '"Plus Jakarta Sans", sans-serif'
    when 'georgia'
      assign heading_font_family_css = 'Georgia, "Times New Roman", serif'
    when 'arial'
      assign heading_font_family_css = 'Arial, Helvetica, sans-serif'
    else
      assign heading_font_family_css = 'eidetic-neo, Georgia, "Times New Roman", serif'
  endcase
  assign heading_fw = section.settings.heading_font_weight | default: 400
  assign container_w = section.settings.container_width | default: 1110
  assign gap_px = section.settings.gap | default: 48

  assign exp_placeholder = section.settings.experience_type_placeholder | default: 'Please select'
  assign exp_raw = section.settings.experience_type_options | strip
  if exp_raw == blank
    assign exp_opts = 'Standard tasting|Premium tasting|Private tour|Masterclass' | split: '|'
  else
    assign exp_opts = exp_raw | newline_to_br | split: '<br />'
  endif
-%}

<section
  {% if section.settings.section_anchor_id != blank %}id="{{ section.settings.section_anchor_id | handleize }}"{% endif %}
  class="fe-alternating-content-form fe-alternating-content-form--{{ sid }}{% if position == 'form_left' %} fe-alternating-content-form--form-left{% endif %}"
>
  <div class="fe-alternating-content-form__inner">
    <div class="fe-alternating-content-form__grid">
      <div class="fe-alternating-content-form__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="fe-alternating-content-form__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="fe-alternating-content-form__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="fe-alternating-content-form__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'contact_info_list' -%}
            {% render 'fe-contact-info-list', block: block, scope_class: cil_scope %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="fe-alternating-content-form__form-wrap">
        {%- if form_mode == 'static' -%}
          <form
            class="fe-alternating-content-form__form fe-alternating-content-form__form--static"
            data-fe-acf-static-form
            novalidate
          >
            {%- if section.settings.form_heading != blank -%}
              <h3 class="fe-alternating-content-form__form-title">{{ section.settings.form_heading | escape }}</h3>
            {%- endif -%}

            <div class="fe-alternating-content-form__fields" data-fe-acf-fields>
              <div class="fe-alternating-content-form__row">
                <div class="fe-alternating-content-form__field" data-fe-acf-field-wrap>
                  <label class="visually-hidden" for="fe-acf-fn-{{ sid }}">First Name (required)</label>
                  <input
                    class="fe-alternating-content-form__input"
                    id="fe-acf-fn-{{ sid }}"
                    name="first_name"
                    type="text"
                    autocomplete="given-name"
                    required
                    placeholder="First Name *"
                    aria-required="true"
                    aria-describedby="fe-acf-fn-{{ sid }}-err"
                  >
                  <p id="fe-acf-fn-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
                </div>
                <div class="fe-alternating-content-form__field" data-fe-acf-field-wrap>
                  <label class="visually-hidden" for="fe-acf-ln-{{ sid }}">Last Name (required)</label>
                  <input
                    class="fe-alternating-content-form__input"
                    id="fe-acf-ln-{{ sid }}"
                    name="last_name"
                    type="text"
                    autocomplete="family-name"
                    required
                    placeholder="Last Name *"
                    aria-required="true"
                    aria-describedby="fe-acf-ln-{{ sid }}-err"
                  >
                  <p id="fe-acf-ln-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
                </div>
              </div>

              <div class="fe-alternating-content-form__row">
                <div class="fe-alternating-content-form__field" data-fe-acf-field-wrap>
                  <label class="visually-hidden" for="fe-acf-ph-{{ sid }}">Phone (required)</label>
                  <input
                    class="fe-alternating-content-form__input"
                    id="fe-acf-ph-{{ sid }}"
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    required
                    placeholder="Phone *"
                    aria-required="true"
                    aria-describedby="fe-acf-ph-{{ sid }}-err"
                  >
                  <p id="fe-acf-ph-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
                </div>
                <div class="fe-alternating-content-form__field" data-fe-acf-field-wrap>
                  <label class="visually-hidden" for="fe-acf-guests-{{ sid }}">Number of guests</label>
                  <input
                    class="fe-alternating-content-form__input"
                    id="fe-acf-guests-{{ sid }}"
                    name="number_of_guests"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    placeholder="Number of guests"
                    aria-describedby="fe-acf-guests-{{ sid }}-err"
                  >
                  <p id="fe-acf-guests-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
                </div>
              </div>

              <div class="fe-alternating-content-form__row">
                <div class="fe-alternating-content-form__field" data-fe-acf-field-wrap>
                  <label class="visually-hidden" for="fe-acf-exp-{{ sid }}">Experience type</label>
                  <select
                    class="fe-alternating-content-form__select"
                    id="fe-acf-exp-{{ sid }}"
                    name="experience_type"
                    aria-describedby="fe-acf-exp-{{ sid }}-err"
                  >
                    <option value="" selected disabled>{{ exp_placeholder | escape }}</option>
                    {%- for opt_line in exp_opts -%}
                      {%- assign opt = opt_line | strip -%}
                      {%- if opt != blank -%}
                        <option value="{{ opt | escape }}">{{ opt | escape }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                  <p id="fe-acf-exp-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
                </div>
                <div class="fe-alternating-content-form__field" data-fe-acf-field-wrap>
                  <label class="visually-hidden" for="fe-acf-em-{{ sid }}">Email (required)</label>
                  <input
                    class="fe-alternating-content-form__input"
                    id="fe-acf-em-{{ sid }}"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    placeholder="Email *"
                    aria-required="true"
                    aria-describedby="fe-acf-em-{{ sid }}-err"
                  >
                  <p id="fe-acf-em-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
                </div>
              </div>

              <div class="fe-alternating-content-form__field fe-alternating-content-form__field--checkbox">
                <label class="fe-alternating-content-form__checkbox-label" for="fe-acf-mail-{{ sid }}">
                  <input class="fe-alternating-content-form__checkbox" id="fe-acf-mail-{{ sid }}" name="mailing_list_opt_in" type="checkbox" value="yes">
                  <span>Opt into mailing list</span>
                </label>
              </div>

              <div class="fe-alternating-content-form__field" data-fe-acf-field-wrap>
                <label class="visually-hidden" for="fe-acf-date-{{ sid }}">Date (required)</label>
                <div class="fe-alternating-content-form__date-wrap">
                  <input
                    class="fe-alternating-content-form__input fe-alternating-content-form__input--date"
                    id="fe-acf-date-{{ sid }}"
                    name="booking_date"
                    type="date"
                    required
                    aria-required="true"
                    aria-describedby="fe-acf-date-{{ sid }}-err"
                  >
                  <span class="fe-alternating-content-form__date-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                      <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </span>
                </div>
                <p id="fe-acf-date-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
              </div>

              <div data-fe-acf-field-wrap data-fe-acf-time-wrap>
                <fieldset class="fe-alternating-content-form__fieldset" aria-describedby="fe-acf-time-{{ sid }}-err">
                  <legend class="visually-hidden">
                    Preferred booking time (required)
                  </legend>
                  <p class="fe-alternating-content-form__legend fe-alternating-content-form__legend--time" aria-hidden="false">
                    Preferred booking time <span class="fe-alternating-content-form__req" aria-hidden="true">*</span>
                  </p>
                  <div class="fe-alternating-content-form__radios">
                    <label class="fe-alternating-content-form__radio-label">
                      <input class="fe-alternating-content-form__radio" type="radio" name="preferred_booking_time" value="10-11">
                      <span>10–11am</span>
                    </label>
                    <label class="fe-alternating-content-form__radio-label">
                      <input class="fe-alternating-content-form__radio" type="radio" name="preferred_booking_time" value="11-12">
                      <span>11am–12pm</span>
                    </label>
                    <label class="fe-alternating-content-form__radio-label">
                      <input class="fe-alternating-content-form__radio" type="radio" name="preferred_booking_time" value="13-14">
                      <span>1pm–2pm</span>
                    </label>
                    <label class="fe-alternating-content-form__radio-label">
                      <input class="fe-alternating-content-form__radio" type="radio" name="preferred_booking_time" value="14-15">
                      <span>2pm–3pm</span>
                    </label>
                  </div>
                </fieldset>
                <p id="fe-acf-time-{{ sid }}-err" class="fe-alternating-content-form__field-error" role="alert" hidden></p>
              </div>

              <button type="submit" class="fe-alternating-content-form__submit" data-fe-acf-submit>
                {{ section.settings.submit_button_label | default: 'Send' | escape }}
              </button>
            </div>

            <div class="fe-alternating-content-form__success" data-fe-acf-success hidden role="status">
              {{- section.settings.success_message | default: 'Thank you — your message has been received.' | escape | newline_to_br -}}
            </div>
          </form>
        {%- else -%}
          <div class="fe-alternating-content-form__form fe-alternating-content-form__form--custom">
            {%- if section.settings.form_heading != blank -%}
              <h3 class="fe-alternating-content-form__form-title">{{ section.settings.form_heading | escape }}</h3>
            {%- endif -%}
            {%- if section.settings.custom_liquid != blank -%}
              <div class="fe-alternating-content-form__custom-liquid">{{ section.settings.custom_liquid }}</div>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}
                <div class="fe-alternating-content-form__app-slot" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} {
    background-color: {{ section.settings.background_color | default: '#EFEEE9' }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    color: {{ section.settings.text_color | default: '#302313' }};
    box-sizing: border-box;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} *,
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} *::before,
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} *::after {
    box-sizing: border-box;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__inner {
    max-width: {{ container_w }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: {{ gap_px }}px;
    align-items: start;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }}.fe-alternating-content-form--form-left .fe-alternating-content-form__content {
    order: 2;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }}.fe-alternating-content-form--form-left .fe-alternating-content-form__form-wrap {
    order: 1;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__heading {
    margin: 0;
    font-family: {{ heading_font_family_css }};
    font-weight: {{ heading_fw }};
    font-size: clamp({{ heading_fs_min }}px, 3vw, {{ heading_fs_max }}px);
    line-height: 1.14;
    color: {{ section.settings.text_color | default: '#302313' }};
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__body {
    margin: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: {{ content_fs }}px;
    line-height: 1.62;
    color: {{ section.settings.text_color | default: '#302313' }};
    opacity: 0.92;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__body p {
    margin: 0;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__body p + p {
    margin-top: 12px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__button {
    align-self: flex-start;
    margin-top: 4px;
    display: inline-block;
    border: 1px solid {{ section.settings.button_border_color | default: '#302313' }};
    background: {{ section.settings.button_background_color | default: '#302313' }};
    color: {{ section.settings.button_text_color | default: '#ffffff' }};
    text-decoration: none;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 11px 22px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__button:hover {
    background: {{ section.settings.button_text_color | default: '#ffffff' }};
    color: {{ section.settings.button_background_color | default: '#302313' }};
    border-color: {{ section.settings.button_background_color | default: '#302313' }};
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__form-wrap {
    min-width: 0;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__form-title {
    margin: 0 0 18px;
    font-family: {{ heading_font_family_css }};
    font-weight: {{ heading_fw }};
    font-size: clamp({{ heading_fs_min | minus: 4 }}px, 2.4vw, {{ heading_fs_max | minus: 6 }}px);
    line-height: 1.18;
    color: {{ section.settings.text_color | default: '#302313' }};
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__fields {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__req {
    color: #c62828;
    font-weight: 500;
    margin-left: 1px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__field-error {
    margin: 5px 0 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: {{ content_fs | minus: 2 | at_least: 11 }}px;
    line-height: 1.4;
    color: #c62828;
    min-height: 1.2em;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__field--invalid .fe-alternating-content-form__input,
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__field--invalid .fe-alternating-content-form__select,
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__field--invalid .fe-alternating-content-form__input--date {
    border-color: #c62828;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__field--invalid[data-fe-acf-time-wrap] .fe-alternating-content-form__radios {
    outline: 1px solid #c62828;
    outline-offset: 2px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__label {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: {{ content_fs | minus: 1 | at_least: 12 }}px;
    letter-spacing: 0.02em;
    color: {{ section.settings.text_color | default: '#302313' }};
    opacity: 0.88;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__input,
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__textarea,
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__select {
    width: 100%;
    margin: 0;
    padding: 11px 12px;
    border: 1px solid {{ section.settings.input_border_color | default: '#C9C4BE' }};
    background: rgba(255, 255, 255, 0.92);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: {{ content_fs }}px;
    line-height: 1.45;
    color: {{ section.settings.text_color | default: '#302313' }};
    border-radius: 3px;
    transition: border-color 0.2s ease;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__select {
    appearance: none;
    padding-right: 36px;
    background-color: rgba(255, 255, 255, 0.92);
    background-image: linear-gradient(45deg, transparent 50%, rgba(48, 35, 19, 0.55) 50%), linear-gradient(135deg, rgba(48, 35, 19, 0.55) 50%, transparent 50%);
    background-position: calc(100% - 18px) calc(50% + 3px), calc(100% - 13px) calc(50% + 3px);
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    cursor: pointer;
    color: {{ section.settings.text_color | default: '#302313' }};
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__select:invalid {
    color: rgba(48, 35, 19, 0.45);
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__select:valid,
  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__select option {
    color: {{ section.settings.text_color | default: '#302313' }};
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__field--checkbox {
    padding-top: 2px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__checkbox-label {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: {{ content_fs }}px;
    line-height: 1.45;
    color: {{ section.settings.text_color | default: '#302313' }};
    opacity: 0.92;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__checkbox {
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    flex-shrink: 0;
    accent-color: {{ section.settings.text_color | default: '#302313' }};
    cursor: pointer;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__date-wrap {
    position: relative;
    width: 100%;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__input--date {
    padding-right: 42px;
    min-height: 44px;
    position: relative;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__input--date::-webkit-calendar-picker-indicator {
    opacity: 0;
    position: absolute;
    right: 0;
    width: 42px;
    height: 100%;
    cursor: pointer;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__date-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: rgba(48, 35, 19, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__legend--time {
    display: block;
    width: 100%;
    margin: 0 0 10px;
    padding: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: {{ content_fs | minus: 1 | at_least: 12 }}px;
    letter-spacing: 0.02em;
    color: {{ section.settings.text_color | default: '#302313' }};
    opacity: 0.88;
    font-weight: 400;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__radios {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .fe-alternating-content-form.fe-alternating-content-form--{{ sid }} .fe-alternating-content-form__radio-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
