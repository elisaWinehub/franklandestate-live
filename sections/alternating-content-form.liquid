{%- if form_mode == 'static' -%}
<script>
  (function () {
    var root = document.querySelector('.fe-alternating-content-form--{{ sid }}');
    if (!root) return;
    var form = root.querySelector('[data-fe-acf-static-form]');
    if (!form || form.dataset.feAcfInit === '1') return;
    form.dataset.feAcfInit = '1';

    var MSG_REQUIRED = 'This field is required';
    var MSG_EMAIL = 'Please enter a valid email address';

    var fieldsEl = form.querySelector('[data-fe-acf-fields]');
    var submitBtn = form.querySelector('[data-fe-acf-submit]');
    var successEl = form.querySelector('[data-fe-acf-success]');
    var timeWrap = form.querySelector('[data-fe-acf-time-wrap]');
    var timeErr = document.getElementById('fe-acf-time-{{ sid }}-err');

    function emailOk(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v || '').trim());
    }

    function errNodeFor(el) {
      var ref = el.getAttribute('aria-describedby');
      if (!ref) return null;
      var id = ref.trim().split(/\s+/)[0];
      return document.getElementById(id);
    }

    function showErr(el, msg) {
      var node = errNodeFor(el);
      if (!node) return;
      node.textContent = msg;
      node.hidden = false;
      el.setAttribute('aria-invalid', 'true');
      var wrap = el.closest('[data-fe-acf-field-wrap]');
      if (wrap) wrap.classList.add('fe-alternating-content-form__field--invalid');
    }

    function clearErr(el) {
      var node = errNodeFor(el);
      if (!node) return;
      node.textContent = '';
      node.hidden = true;
      el.removeAttribute('aria-invalid');
      var wrap = el.closest('[data-fe-acf-field-wrap]');
      if (wrap) wrap.classList.remove('fe-alternating-content-form__field--invalid');
    }

    function validateEmail(el) {
      var v = el.value.trim();
      if (!v) {
        showErr(el, MSG_REQUIRED);
        return false;
      }
      if (!emailOk(v)) {
        showErr(el, MSG_EMAIL);
        return false;
      }
      clearErr(el);
      return true;
    }

    function validateTextRequired(el) {
      if (!el.value || !String(el.value).trim()) {
        showErr(el, MSG_REQUIRED);
        return false;
      }
      clearErr(el);
      return true;
    }

    function validateDateEl(el) {
      if (!el.value) {
        showErr(el, MSG_REQUIRED);
        return false;
      }
      clearErr(el);
      return true;
    }

    function validateTimeGroup() {
      var checked = form.querySelector('input[name="preferred_booking_time"]:checked');
      if (!checked) {
        if (timeErr) {
          timeErr.textContent = MSG_REQUIRED;
          timeErr.hidden = false;
        }
        if (timeWrap) timeWrap.classList.add('fe-alternating-content-form__field--invalid');
        return false;
      }
      if (timeErr) {
        timeErr.textContent = '';
        timeErr.hidden = true;
      }
      if (timeWrap) timeWrap.classList.remove('fe-alternating-content-form__field--invalid');
      return true;
    }

    function runSubmitValidation() {
      var ok = true;
      var fn = form.querySelector('#fe-acf-fn-{{ sid }}');
      var ln = form.querySelector('#fe-acf-ln-{{ sid }}');
      var ph = form.querySelector('#fe-acf-ph-{{ sid }}');
      var em = form.querySelector('#fe-acf-em-{{ sid }}');
      var dt = form.querySelector('#fe-acf-date-{{ sid }}');

      if (fn && !validateTextRequired(fn)) ok = false;
      if (ln && !validateTextRequired(ln)) ok = false;
      if (ph && !validateTextRequired(ph)) ok = false;
      if (em && !validateEmail(em)) ok = false;
      if (dt && !validateDateEl(dt)) ok = false;
      if (!validateTimeGroup()) ok = false;

      return ok;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!fieldsEl || !successEl) return;

      if (!runSubmitValidation()) {
        var invalid = form.querySelector('[aria-invalid="true"]');
        if (invalid && typeof invalid.focus === 'function') {
          invalid.focus();
        } else if (timeWrap && timeWrap.classList.contains('fe-alternating-content-form__field--invalid')) {
          var r = timeWrap.querySelector('input[type="radio"]');
          if (r && typeof r.focus === 'function') r.focus();
        }
        return;
      }

      fieldsEl.setAttribute('hidden', '');
      if (submitBtn) submitBtn.setAttribute('hidden', '');
      successEl.removeAttribute('hidden');
    });

    form.addEventListener('input', function (e) {
      var t = e.target;
      if (!t || !t.matches('input, select')) return;

      if (t.name === 'preferred_booking_time') return;

      if (t.name === 'email') {
        var v = t.value.trim();
        if (!v) {
          clearErr(t);
          return;
        }
        if (emailOk(v)) clearErr(t);
        else showErr(t, MSG_EMAIL);
        return;
      }

      if (t.name === 'booking_date') {
        if (t.value) clearErr(t);
        return;
      }

      if (
        t.name === 'first_name' ||
        t.name === 'last_name' ||
        t.name === 'phone'
      ) {
        if (t.value && String(t.value).trim()) clearErr(t);
      }
    });

    form.addEventListener('change', function (e) {
      var t = e.target;
      if (t && t.name === 'preferred_booking_time') validateTimeGroup();
      if (t && t.name === 'booking_date' && t.value) clearErr(t);
    });
  })();
</script>
{%- endif -%}

