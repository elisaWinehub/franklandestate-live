  }

  .fe-hdr__dropdown-link {
    font-family: Arial, sans-serif;
    font-size: 16px;
    line-height: 1.34;
    color: #534846;
    text-decoration: none;
    display: inline-block;
  }

  .fe-hdr__dropdown-link:hover {
    opacity: 0.7;
  }

  .fe-hdr__dropdown-sublist {
    margin-top: 6px;
    padding-left: 12px;
  }

  .fe-hdr__dropdown-sublist li + li {
    margin-top: 5px;
  }

  .fe-hdr__dropdown-sublink {
    font-family: Arial, sans-serif;
    font-size: 13px;
    color: rgba(83, 72, 70, 0.85);
    text-decoration: none;
  }

  .fe-hdr__dropdown-sublink:hover {
    opacity: 0.7;
  }

  .fe-hdr__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .fe-hdr__action-btn {
    position: relative;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
  }

  .fe-hdr__action-btn:hover {
    opacity: 0.75;
  }

  .fe-cart-count {
    position: absolute;
    top: 3px;
    right: 2px;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    background: var(--fe-text-def, #ffffff);
    color: var(--fe-bg-alt, #534846);
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .fe-hdr-{{ sid }}.fe-scrolled .fe-cart-count,
  body.fe-menu-open .fe-hdr-{{ sid }} .fe-cart-count {
    background: var(--fe-text-alt, #534846);
    color: var(--fe-bg-alt, #efeee9);
  }

  .fe-hdr__burger {
    width: 56px;
    min-height: 52px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 4px;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: 0;
  }

  @media (min-width: 841px) {
    .fe-hdr-{{ sid }} .fe-hdr__burger.fe-hdr__burger--desktop-hidden {
      display: none !important;
    }
  }

  @media (max-width: 840px) {
    .fe-hdr-{{ sid }} .fe-hdr__burger.fe-hdr__burger--desktop-hidden {
      display: inline-flex !important;
    }
  }

  .fe-burger__bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .fe-burger__label {
    font-family: Arial, sans-serif;
    font-size: 12px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    margin-top: 4px;
  }

  .fe-burger__label--close {
    display: none;
  }

  body.fe-menu-open .fe-burger__bar--top {
    transform: translateY(5.5px) rotate(45deg);
  }

  body.fe-menu-open .fe-burger__bar--mid {
    opacity: 0;
    transform: scaleX(0);
  }

  body.fe-menu-open .fe-burger__bar--bot {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  body.fe-menu-open .fe-burger__label--menu {
    display: none;
  }

  body.fe-menu-open .fe-burger__label--close {
    display: block;
  }

  .fe-overlay-{{ sid }} {
    position: fixed;
    left: 0;
    right: 0;
    top: calc(var(--fe-bar-height, 0px) + var(--fe-header-height, 88px));
    height: calc(100vh - var(--fe-bar-height, 0px) - var(--fe-header-height, 88px));
    z-index: 340;
    background: var(--fe-bg-alt, #efeee9);
    color: var(--fe-text-alt, #534846);
    border-top: 1px solid rgba(83, 72, 70, 0.2);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .fe-overlay-{{ sid }}[hidden] {
    display: none;
  }

  .fe-overlay__inner {
    max-width: 1180px;
    margin: 0 auto;
    min-height: 100%;
    padding: clamp(32px, 5vw, 56px) clamp(20px, 4vw, 44px) clamp(22px, 4vw, 36px);
    display: flex;
    flex-direction: column;
  }

  .fe-overlay__body {
    flex: 1 1 auto;
    border-bottom: 1px solid rgba(83, 72, 70, 0.2);
    padding-bottom: clamp(28px, 5vw, 48px);
  }

  .fe-overlay__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px clamp(32px, 4vw, 64px);
  }

  .fe-overlay__col {
    min-width: 0;
  }

  .fe-overlay__heading {
    margin: 0 0 16px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(28px, 2.8vw, 32px);
    line-height: 1.1;
    font-weight: 400;
    color: #534846;
  }

  .fe-overlay__list,
  .fe-overlay__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fe-overlay__item + .fe-overlay__item {
    margin-top: 10px;
  }

  .fe-overlay__link {
    display: inline-block;
    font-family: Arial, sans-serif;
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.35;
    color: #534846;
    text-decoration: none;
  }

  .fe-overlay__link:hover {
    opacity: 0.7;
  }

  .fe-overlay__sublist {
    margin-top: 8px;
    padding-left: 16px;
  }

  .fe-overlay__sublist li + li {
    margin-top: 6px;
  }

  .fe-overlay__sublink {
    font-family: Arial, sans-serif;
    font-size: 16px;
    color: rgba(83, 72, 70, 0.82);
    text-decoration: none;
  }

  .fe-overlay__sublink:hover {
    opacity: 0.7;
  }

  .fe-overlay__footer {
    padding-top: clamp(18px, 3vw, 28px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .fe-overlay__social {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fe-overlay__social a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(83, 72, 70, 0.34);
    color: #534846;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .fe-overlay__social a:hover {
    border-color: rgba(83, 72, 70, 0.62);
    opacity: 0.85;
  }

  .fe-overlay__contact {
    font-family: Arial, sans-serif;
    font-size: 22px;
    color: #534846;
    text-decoration: none;
    line-height: 1.2;
  }

  .fe-overlay__contact:hover {
    opacity: 0.7;
  }

  @media (max-width: 1024px) {
    .fe-hdr__nav {
      gap: 16px;
    }

    .fe-hdr__nav-link {
      font-size: 14px;
    }
  }

  @media (max-width: 840px) {
    .fe-hdr-{{ sid }} {
      padding: 14px 18px;
      min-height: 76px;
    }

    .fe-hdr__nav {
      display: none;
    }

    .fe-overlay__grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .fe-overlay__heading {
      margin-bottom: 10px;
    }

    .fe-overlay__footer {
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }

    .fe-overlay__contact {
      font-size: 20px;
    }
  }
</style>

<script>
(function () {
  'use strict';

  var SID       = {{ section.id | json }};
  var THRESHOLD = 60;
  var FORCE_SOLID = {{ is_solid_header_page | json }};
  var IS_WINEHUB = {{ is_winehub_page | json }};
  var FORCE_LAYOUT = FORCE_SOLID || IS_WINEHUB;

  var bar     = document.getElementById('fe-bar-' + SID);
  var header  = document.getElementById('fe-hdr-'     + SID);
  var burger  = document.getElementById('fe-burger-'  + SID);
  var overlay = document.getElementById('fe-overlay-' + SID);
  var logo    = document.getElementById('fe-logo-'    + SID);

  if (!header || !burger || !overlay) return;

  var menuOpen   = false;
  var srcDefault = logo ? logo.dataset.srcDefault : '';
  var srcColored = logo ? logo.dataset.srcColored : '';

  /* ─── Logo swap ──────────────────────────────────────── *
   *  colored = true  →  logo-menu.svg  (scrolled / menu open)
   *  colored = false →  logo.svg       (transparent / top of page)
   * ──────────────────────────────────────────────────────── */
  function setLogo(colored) {
    if (!logo) return;
    logo.src = colored ? srcColored : srcDefault;
  }

  function setLayoutVars() {
    var barHeight = bar ? bar.offsetHeight : 0;
    var headerHeight = header.offsetHeight;
    document.documentElement.style.setProperty('--fe-bar-height', barHeight + 'px');
    document.documentElement.style.setProperty('--fe-header-height', headerHeight + 'px');
    if (!menuOpen) {
      if (FORCE_LAYOUT) {
        header.style.top = '0px';
      } else {
        header.style.top = window.scrollY > THRESHOLD ? '0px' : (barHeight + 'px');
      }
    }
  }

  /* ─── Scroll state ───────────────────────────────────── */
  function applyScrollState() {
    if (menuOpen) return;
    if (FORCE_LAYOUT) {
      header.classList.remove('fe-scrolled');
      /* WineHub keeps the light logo on the dark header */
      setLogo(FORCE_SOLID && !IS_WINEHUB);
      return;
    }
    var scrolled = window.scrollY > THRESHOLD;
    header.classList.toggle('fe-scrolled', scrolled);
    /* scrolled → logo-menu.svg, at top → logo.svg */
    setLogo(scrolled);
  }

  setLayoutVars();
  window.addEventListener('resize', setLayoutVars);
  window.addEventListener('scroll', applyScrollState, { passive: true });
  applyScrollState();

  /* ─── Open menu ──────────────────────────────────────── */
  function openMenu() {
    menuOpen = true;
    overlay.removeAttribute('hidden');
    document.body.classList.add('fe-menu-open');
    if (!FORCE_LAYOUT) {
      header.classList.remove('fe-scrolled');
      header.style.top = window.scrollY > THRESHOLD ? '0px' : 'var(--fe-bar-height, 0px)';
    } else {
      header.style.top = '0px';
    }
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', 'Close navigation menu');
    setLogo(true); /* always logo-menu.svg when overlay is open */
    var first = overlay.querySelector('a[href]');
    if (first) first.focus();
  }

  /* ─── Close menu ─────────────────────────────────────── */
  function closeMenu() {
    menuOpen = false;
    overlay.setAttribute('hidden', '');
    document.body.classList.remove('fe-menu-open');
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Open navigation menu');
    setLayoutVars();
    applyScrollState(); /* restore correct scroll-based logo + header */
    burger.focus();
  }

  /* ─── Toggles ────────────────────────────────────────── */
  burger.addEventListener('click', function () {
    overlay.hasAttribute('hidden') ? openMenu() : closeMenu();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) closeMenu();
  });
})();
</script>

