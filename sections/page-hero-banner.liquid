{%- liquid
  assign sid = section.id
  assign has_page_title = false
  if page and page.title != blank
    assign has_page_title = true
  endif

  assign hero_title = section.settings.heading
  if hero_title == blank and has_page_title
    assign hero_title = page.title
  endif
  if hero_title == blank and blog and blog.title != blank
    assign hero_title = blog.title
  endif
  if hero_title == blank
    assign hero_title = 'Page Title'
  endif

  assign vertical_position = section.settings.text_vertical_position
-%}

<section
  class="fe-page-hero fe-page-hero--{{ sid }} fe-page-hero--{{ sid }}--{{ vertical_position }}"
  aria-label="{{ hero_title | escape }}"
>
  <div class="fe-page-hero__media">
    {%- if section.settings.image != blank -%}
      <img
        class="fe-page-hero__img fe-page-hero__img--desktop"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.image | image_url: width: 900 }} 900w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w,
          {{ section.settings.image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape | default: hero_title }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

    {%- if section.settings.mobile_image != blank -%}
      <img
        class="fe-page-hero__img fe-page-hero__img--mobile"
        src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
        srcset="
          {{ section.settings.mobile_image | image_url: width: 600 }} 600w,
          {{ section.settings.mobile_image | image_url: width: 900 }} 900w,
          {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
        "
        sizes="100vw"
        alt="{{ section.settings.mobile_image.alt | escape | default: hero_title }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

    <div class="fe-page-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="fe-page-hero__content">
    <h1 class="fe-page-hero__title">{{ hero_title | escape }}</h1>
  </div>
</section>

<style>
  .fe-page-hero--{{ sid }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.desktop_height }}px;
    min-height: 240px;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .fe-page-hero--{{ sid }} .fe-page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .fe-page-hero--{{ sid }} .fe-page-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position }};
    display: block;
  }

  .fe-page-hero--{{ sid }} .fe-page-hero__img--mobile {
    display: none;
  }

  .fe-page-hero--{{ sid }} .fe-page-hero__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }

  .fe-page-hero--{{ sid }} .fe-page-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .fe-page-hero--{{ sid }}--center .fe-page-hero__content {
    align-items: center;
  }

  .fe-page-hero--{{ sid }}--lower-center .fe-page-hero__content {
    align-items: center;
  }

  .fe-page-hero--{{ sid }}--lower-center .fe-page-hero__title {
    transform: translateY(34%);
  }

  .fe-page-hero--{{ sid }}--bottom .fe-page-hero__content {
    align-items: flex-end;
    padding-bottom: clamp(20px, 6%, 44px);
  }

  .fe-page-hero--{{ sid }} .fe-page-hero__title {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    line-height: 1.12;
    font-size: clamp(34px, 4.6vw, 54px);
    color: {{ section.settings.text_color }};
    text-wrap: balance;
  }

  @media (max-width: 768px) {
    .fe-page-hero--{{ sid }} {
      height: {{ section.settings.mobile_height }}px;
    }

    .fe-page-hero--{{ sid }}--lower-center .fe-page-hero__content {
      align-items: center;
    }

    .fe-page-hero--{{ sid }}--lower-center .fe-page-hero__title {
      transform: translateY(24%);
    }

    .fe-page-hero--{{ sid }} .fe-page-hero__title {
      font-size: clamp(28px, 8vw, 42px);
    }

    {%- if section.settings.mobile_image != blank -%}
      .fe-page-hero--{{ sid }} .fe-page-hero__img--desktop {
        display: none;
      }
      .fe-page-hero--{{ sid }} .fe-page-hero__img--mobile {
        display: block;
      }
    {%- endif -%}
  }
</style>

{% schema %}
{
  "name": "Page Hero Banner",
  "tag": "section",
  "class": "fe-page-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "If blank, this uses the page title automatically."
    },
    {
      "type": "select",
      "id": "text_vertical_position",
      "label": "Text vertical position",
      "default": "lower-center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "lower-center", "label": "Lower center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background position",
      "default": "center center",
      "options": [
        { "value": "top left", "label": "Top left" },
        { "value": "top center", "label": "Top center" },
        { "value": "top right", "label": "Top right" },
        { "value": "center left", "label": "Center left" },
        { "value": "center center", "label": "Center center" },
        { "value": "center right", "label": "Center right" },
        { "value": "bottom left", "label": "Bottom left" },
        { "value": "bottom center", "label": "Bottom center" },
        { "value": "bottom right", "label": "Bottom right" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color fallback",
      "default": "#EFEEE9"
    },
    {
      "type": "header",
      "content": "Height & overlay"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "unit": "px",
      "min": 280,
      "max": 900,
      "step": 10,
      "default": 560
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "unit": "px",
      "min": 220,
      "max": 700,
      "step": 10,
      "default": 360
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "unit": "%",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Page Hero Banner"
    }
  ]
}
{% endschema %}
