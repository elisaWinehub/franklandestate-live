{%- liquid
  assign sid        = section.id
  assign overlay_op = section.settings.overlay_opacity | divided_by: 100.0
  assign text_align = section.settings.text_alignment | default: 'center'
  assign height_vh  = section.settings.section_height
  assign mob_height = section.settings.mobile_height
  assign pad_top    = section.settings.padding_top
  assign pad_bottom = section.settings.padding_bottom
  assign bg_color   = section.settings.background_color
-%}

<section
  class="fe-banner fe-banner--{{ sid }}"
  aria-label="{{ section.settings.title | escape | default: 'Banner' }}"
>
  <div class="fe-banner__container">
    {%- comment -%} Background image {%- endcomment -%}
    <div class="fe-banner__bg">
      {%- if section.settings.image != blank or section.settings.image_url != blank -%}
        {%- if section.settings.image != blank -%}
          <img
            class="fe-banner__img fe-banner__img--desktop"
            src="{{ section.settings.image | image_url: width: 2000 }}"
            srcset="
              {{ section.settings.image | image_url: width: 800  }} 800w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1600 }} 1600w,
              {{ section.settings.image | image_url: width: 2000 }} 2000w
            "
            sizes="(min-width: 1110px) 1110px, 100vw"
            alt="{{ section.settings.image.alt | escape | default: section.settings.title }}"
            loading="lazy"
          >
        {%- else -%}
          <img
            class="fe-banner__img fe-banner__img--desktop"
            src="{{ section.settings.image_url }}"
            alt="{{ section.settings.title | escape }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.mobile_image != blank or section.settings.mobile_image_url != blank -%}
        {%- if section.settings.mobile_image != blank -%}
          <img
            class="fe-banner__img fe-banner__img--mobile"
            src="{{ section.settings.mobile_image | image_url: width: 800 }}"
            alt="{{ section.settings.mobile_image.alt | escape | default: section.settings.title }}"
            loading="lazy"
          >
        {%- else -%}
          <img
            class="fe-banner__img fe-banner__img--mobile"
            src="{{ section.settings.mobile_image_url }}"
            alt="{{ section.settings.title | escape }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- endif -%}
      <div class="fe-banner__overlay" style="opacity:{{ overlay_op }}"></div>
    </div>

    {%- comment -%} Content {%- endcomment -%}
    <div class="fe-banner__content fe-banner__content--{{ text_align }}">
      {%- if section.settings.title != blank -%}
        <h2 class="fe-banner__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="fe-banner__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <div class="fe-banner__button-wrap fe-banner__button-wrap--{{ text_align }}">
          <a href="{{ section.settings.button_link }}" class="fe-banner__btn">
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .fe-banner--{{ sid }} {
    position: relative;
    width: 100%;
    background-color: {{ bg_color }};
    padding-top: {{ pad_top }}px;
    padding-bottom: {{ pad_bottom }}px;
    padding-inline: 16px;
    box-sizing: border-box;
  }

  .fe-banner--{{ sid }} .fe-banner__container {
    position: relative;
    width: 100%;
    max-width: 1110px;
    margin: 0 auto;
    height: {{ height_vh }}vh;
    min-height: 260px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .fe-banner--{{ sid }} .fe-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .fe-banner--{{ sid }} .fe-banner__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .fe-banner--{{ sid }} .fe-banner__img--mobile { display: none; }

  .fe-banner--{{ sid }} .fe-banner__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }

  .fe-banner--{{ sid }} .fe-banner__content {
    position: relative;
    z-index: 1;
    padding: 32px 24px;
    width: 100%;
    max-width: 900px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  .fe-banner--{{ sid }} .fe-banner__content--left {
    text-align: left;
    align-items: flex-start;
  }

  .fe-banner--{{ sid }} .fe-banner__content--center {
    text-align: center;
    align-items: center;
  }

  .fe-banner--{{ sid }} .fe-banner__content--right {
    text-align: right;
    align-items: flex-end;
  }

  .fe-banner--{{ sid }} .fe-banner__title {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(26px, 3.5vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    margin: 0;
  }

  .fe-banner--{{ sid }} .fe-banner__subtitle {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(14px, 1.5vw, 18px);
    margin: 0;
    opacity: 0.9;
    max-width: 580px;
  }

  .fe-banner--{{ sid }} .fe-banner__button-wrap {
    width: 100%;
    display: flex;
  }

  .fe-banner--{{ sid }} .fe-banner__button-wrap--left {
    justify-content: flex-start;
  }

  .fe-banner--{{ sid }} .fe-banner__button-wrap--center {
    justify-content: center;
  }

  .fe-banner--{{ sid }} .fe-banner__button-wrap--right {
    justify-content: flex-end;
  }

  .fe-banner--{{ sid }} .fe-banner__btn {
    display: inline-block;
    border: 2px solid {{ section.settings.button_bg_color }};
    padding: 12px 28px;
    font-family: Arial, sans-serif;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .fe-banner--{{ sid }} .fe-banner__btn:hover {
    background: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_bg_color }};
  }

  /* Mobile */
  @media (max-width: 768px) {
    .fe-banner--{{ sid }} {
      padding-top: clamp(24px, 6vw, {{ pad_top }}px);
      padding-bottom: clamp(24px, 6vw, {{ pad_bottom }}px);
    }

    .fe-banner--{{ sid }} .fe-banner__container {
      height: {{ mob_height }}vh;
    }

    {%- if section.settings.mobile_image != blank or section.settings.mobile_image_url != blank -%}
      .fe-banner--{{ sid }} .fe-banner__img--desktop { display: none; }
      .fe-banner--{{ sid }} .fe-banner__img--mobile  { display: block; }
    {%- endif -%}
  }
</style>

{% schema %}
{
  "name": "Full-width Image Banner",
  "tag": "div",
  "class": "fe-image-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Desktop image URL (temporary)",
      "default": "https://www.franklandestate.com.au/dist/images/sitegates/content/background.jpg"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "text",
      "id": "mobile_image_url",
      "label": "Mobile image URL (temporary)",
      "default": "https://www.franklandestate.com.au/dist/images/sitegates/signup/background.jpg"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Button colors"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#302313"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background color",
      "default": "#302313"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Height & overlay"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EFEEE9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop height",
      "default": 55
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile height",
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Full-width Image Banner"
    }
  ]
}
{% endschema %}
