{%- liquid
  assign sid = section.id
  assign num_cols = section.settings.footer_columns | default: '3' | plus: 0
  if num_cols != 4
    assign num_cols = 3
  endif

  assign overlay_op = section.settings.overlay_opacity | default: 35 | times: 1.0 | divided_by: 100.0
  assign bg_color = section.settings.background_color | default: '#302313'
  assign overlay_color = section.settings.overlay_color | default: '#000000'
  assign show_dividers = section.settings.show_column_dividers

  assign legal_menu_handle = section.settings.legal_menu
  if legal_menu_handle == blank
    assign legal_menu_handle = 'tc-menu'
  endif
  assign legal_menu = linklists[legal_menu_handle]

  assign use_blocks = false
  if section.blocks.size > 0
    assign use_blocks = true
  endif

  assign menu_1_handle = section.settings.footer_menu_1
  if menu_1_handle == blank
    assign menu_1_handle = 'footer-shop'
  endif
  assign menu_2_handle = section.settings.footer_menu_2
  if menu_2_handle == blank
    assign menu_2_handle = 'footer-about'
  endif
  assign menu_3_handle = section.settings.footer_menu_3
  if menu_3_handle == blank
    assign menu_3_handle = 'footer-contact'
  endif
  assign menu_1 = linklists[menu_1_handle]
  assign menu_2 = linklists[menu_2_handle]
  assign menu_3 = linklists[menu_3_handle]

  assign footer_pad_top = section.settings.padding_top | default: 64
  assign footer_pad_bottom = section.settings.padding_bottom | default: 32

  assign footer_menu_fs = section.settings.footer_menu_font_size | default: 14
  assign footer_text_fs = section.settings.footer_text_font_size | default: 14

  assign heading_fs_max = section.settings.heading_font_size | default: 32
  assign heading_fs_min = heading_fs_max | minus: 6
  if heading_fs_min < 17
    assign heading_fs_min = 17
  endif

  assign heading_ff = section.settings.heading_font_family | default: 'georgia'
  assign heading_font_family_css = 'Georgia, "Times New Roman", serif'
  case heading_ff
    when 'plus_jakarta'
      assign heading_font_family_css = '"Plus Jakarta Sans", sans-serif'
    when 'eidetic_neo'
      assign heading_font_family_css = 'eidetic-neo, Georgia, "Times New Roman", serif'
    when 'arial'
      assign heading_font_family_css = 'Arial, Helvetica, sans-serif'
    else
      assign heading_font_family_css = 'Georgia, "Times New Roman", serif'
  endcase
-%}

<footer class="fe-footer fe-footer--{{ sid }}{% if show_dividers %} fe-footer--dividers{% endif %}" role="contentinfo" style="--fe-footer-bg: {{ bg_color }}; color: rgba(255, 255, 255, 0.78);">
  <div class="fe-footer__backdrop">
    {%- if section.settings.background_image != blank -%}
      <img
        class="fe-footer__backdrop-img"
        src="{{ section.settings.background_image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.background_image | image_url: width: 900 }} 900w,
          {{ section.settings.background_image | image_url: width: 1400 }} 1400w,
          {{ section.settings.background_image | image_url: width: 2000 }} 2000w,
          {{ section.settings.background_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt=""
        loading="lazy"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
      >
    {%- endif -%}
    <div class="fe-footer__backdrop-overlay" style="background-color: {{ overlay_color }}; opacity: {{ overlay_op }};"></div>
  </div>

  <div class="fe-footer__inner">
    {%- if use_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'logo' and block.settings.layout == 'above_columns' -%}
          <div
            class="fe-footer__logo-row fe-footer__align-{{ block.settings.alignment | default: 'center' }}"
            {{ block.shopify_attributes }}
          >
            <a href="{{ routes.root_url }}" class="fe-footer__logo-link" aria-label="{{ shop.name | escape }}">
              {%- if block.settings.logo_svg != blank -%}
                <div class="fe-footer__logo-svg" style="width: {{ block.settings.logo_width | default: 230 }}px;">{{ block.settings.logo_svg }}</div>
              {%- elsif block.settings.logo_image != blank -%}
                <img
                  class="fe-footer__logo"
                  src="{{ block.settings.logo_image | image_url: width: 640 }}"
                  alt="{{ shop.name | escape }}"
                  style="width: {{ block.settings.logo_width | default: 230 }}px;"
                  loading="lazy"
                  width="{{ block.settings.logo_image.width }}"
                  height="{{ block.settings.logo_image.height }}"
                >
              {%- elsif section.settings.footer_logo != blank -%}
                <img
                  class="fe-footer__logo"
                  src="{{ section.settings.footer_logo | image_url: width: 640 }}"
                  alt="{{ shop.name | escape }}"
                  style="width: {{ block.settings.logo_width | default: section.settings.footer_logo_width }}px;"
                  loading="lazy"
                >
              {%- else -%}
                <img
                  class="fe-footer__logo"
                  src="{{ 'logo.svg' | asset_url }}"
                  alt="{{ shop.name | escape }}"
                  style="width: {{ block.settings.logo_width | default: 230 }}px;"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="fe-footer__grid fe-footer__grid--{{ num_cols }}" role="navigation" aria-label="Footer">
        {%- for col_idx in (1..num_cols) -%}
          <div class="fe-footer__col">
            {%- for block in section.blocks -%}
              {%- liquid
                if block.type == 'logo' and block.settings.layout == 'above_columns'
                  continue
                endif
                assign cn = block.settings.column_number | default: '1' | plus: 0
                if num_cols == 3 and cn > 3
                  assign cn = 3
                endif
                if cn != col_idx
                  continue
                endif
              -%}
              {%- case block.type -%}
                {%- when 'logo' -%}
                  <div class="fe-footer__block fe-footer__block--logo fe-footer__align-{{ block.settings.alignment | default: 'center' }}" {{ block.shopify_attributes }}>
                    <a href="{{ routes.root_url }}" class="fe-footer__logo-link" aria-label="{{ shop.name | escape }}">
                      {%- if block.settings.logo_svg != blank -%}
                        <div class="fe-footer__logo-svg" style="width: {{ block.settings.logo_width | default: 230 }}px;">{{ block.settings.logo_svg }}</div>
                      {%- elsif block.settings.logo_image != blank -%}
                        <img
                          class="fe-footer__logo"
                          src="{{ block.settings.logo_image | image_url: width: 640 }}"
                          alt="{{ shop.name | escape }}"
                          style="width: {{ block.settings.logo_width | default: 230 }}px;"
                          loading="lazy"
                          width="{{ block.settings.logo_image.width }}"
                          height="{{ block.settings.logo_image.height }}"
                        >
                      {%- elsif section.settings.footer_logo != blank -%}
                        <img
                          class="fe-footer__logo"
                          src="{{ section.settings.footer_logo | image_url: width: 640 }}"
                          alt="{{ shop.name | escape }}"
                          style="width: {{ block.settings.logo_width | default: section.settings.footer_logo_width }}px;"
                          loading="lazy"
                        >
                      {%- else -%}
                        <img
                          class="fe-footer__logo"
                          src="{{ 'logo.svg' | asset_url }}"
                          alt="{{ shop.name | escape }}"
                          style="width: {{ block.settings.logo_width | default: 230 }}px;"
                          loading="lazy"
                        >
                      {%- endif -%}
                    </a>
                  </div>

                {%- when 'text' -%}
                  <div class="fe-footer__block fe-footer__block--text fe-footer__align-{{ block.settings.alignment | default: 'center' }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h3 class="fe-footer__block-heading">{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="fe-footer__block-text rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>

                {%- when 'links' -%}
                  {%- assign blk_menu = linklists[block.settings.menu] -%}
                  {%- if blk_menu.links.size > 0 -%}
                    <nav class="fe-footer__block fe-footer__block--links fe-footer__align-{{ block.settings.alignment | default: 'center' }}" aria-label="{{ blk_menu.title | escape }}" {{ block.shopify_attributes }}>
                      {%- if block.settings.heading != blank -%}
                        <h3 class="fe-footer__menu-title">{{ block.settings.heading | escape }}</h3>
                      {%- endif -%}
                      <ul class="fe-footer__menu-list">
                        {%- for link in blk_menu.links -%}
                          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    </nav>
                  {%- endif -%}

                {%- when 'social' -%}
                  <div class="fe-footer__block fe-footer__block--social fe-footer__align-{{ block.settings.alignment | default: 'center' }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h3 class="fe-footer__block-heading fe-footer__block-heading--social">{{ block.settings.heading | escape }}</h3>
                    {%- endif -%}
                    {%- if block.settings.show_social_icons -%}
                      <div class="fe-footer__socials">
                        {%- if section.settings.social_facebook != blank -%}
                          <a href="{{ section.settings.social_facebook }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                          </a>
                        {%- endif -%}
                        {%- if section.settings.social_twitter != blank -%}
                          <a href="{{ section.settings.social_twitter }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                          </a>
                        {%- endif -%}
                        {%- if section.settings.social_pinterest != blank -%}
                          <a href="{{ section.settings.social_pinterest }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.336.336 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                          </a>
                        {%- endif -%}
                        {%- if section.settings.social_instagram != blank -%}
                          <a href="{{ section.settings.social_instagram }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                          </a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>

    {%- else -%}
      {%- comment -%} Legacy layout when no blocks (existing stores) {%- endcomment -%}
      <div class="fe-footer__logo-wrap">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.footer_logo != blank -%}
            <img
              class="fe-footer__logo"
              src="{{ section.settings.footer_logo | image_url: width: 640 }}"
              alt="{{ shop.name | escape }}"
              style="width:{{ section.settings.footer_logo_width }}px;"
              loading="lazy"
            >
          {%- else -%}
            <img
              class="fe-footer__logo"
              src="{{ 'logo.svg' | asset_url }}"
              alt="{{ shop.name | escape }}"
              style="width:{{ section.settings.footer_logo_width }}px;"
              loading="lazy"
            >
          {%- endif -%}
        </a>
      </div>

      <div class="fe-footer__menus fe-footer__menus--legacy fe-footer__menus--cols-{{ num_cols }}">
        {%- if menu_1.links.size > 0 -%}
          <nav class="fe-footer__menu-col" aria-label="{{ menu_1.title | escape }}">
            <h3 class="fe-footer__menu-title">Shop</h3>
            <ul class="fe-footer__menu-list">
              {%- for link in menu_1.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if menu_2.links.size > 0 -%}
          <nav class="fe-footer__menu-col" aria-label="{{ menu_2.title | escape }}">
            <h3 class="fe-footer__menu-title">About</h3>
            <ul class="fe-footer__menu-list">
              {%- for link in menu_2.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if menu_3.links.size > 0 -%}
          <nav class="fe-footer__menu-col" aria-label="{{ menu_3.title | escape }}">
            <h3 class="fe-footer__menu-title">Contact</h3>
            <ul class="fe-footer__menu-list">
              {%- for link in menu_3.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fe-footer__copyright-area">
      <div class="fe-footer__meta-row">
        <div class="fe-footer__meta-top">
          {%- if legal_menu.links.size > 0 -%}
            <nav class="fe-footer__legal-nav" aria-label="Legal links">
              {%- for link in legal_menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </nav>
          {%- endif -%}

          {%- liquid
            assign show_footer_bar_social = true
            if use_blocks
              assign show_footer_bar_social = true
              for b in section.blocks
                if b.type == 'social' and b.settings.show_social_icons
                  assign show_footer_bar_social = false
                endif
              endfor
            endif
          -%}
          {%- if show_footer_bar_social -%}
            <div class="fe-footer__socials">
              {%- if section.settings.social_facebook != blank -%}
                <a href="{{ section.settings.social_facebook }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.social_twitter != blank -%}
                <a href="{{ section.settings.social_twitter }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.social_pinterest != blank -%}
                <a href="{{ section.settings.social_pinterest }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.336.336 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                </a>
              {%- endif -%}
              {%- if section.settings.social_instagram != blank -%}
                <a href="{{ section.settings.social_instagram }}" class="fe-footer__soc" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="fe-footer__meta-left">
          {%- if section.settings.responsible_drinking_text != blank -%}
            <p class="fe-footer__responsible">{{ section.settings.responsible_drinking_text }}</p>
          {%- endif -%}

          {%- if section.settings.liquor_license_text != blank -%}
            <p class="fe-footer__licence">{{ section.settings.liquor_license_text }}</p>
          {%- endif -%}
        </div>
      </div>

      <p class="fe-footer__copy">
        &copy; {{ 'now' | date: '%Y' }}
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text }}
        {%- else -%}
          - Wine eCommerce & Wine POS System by
        {%- endif -%}
        <span class="fe-footer__copy-dot" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="8.2" cy="10.2" r="2.2"></circle>
            <circle cx="12" cy="8" r="2.2"></circle>
            <circle cx="15.8" cy="10.2" r="2.2"></circle>
            <circle cx="10.2" cy="14.2" r="2.2"></circle>
            <circle cx="13.8" cy="14.2" r="2.2"></circle>
            <path d="M12 5.4V2.2M12 2.2c1.2 0 2-.6 2.6-1.2M12 2.2c-1.2 0-2-.6-2.6-1.2"></path>
          </svg>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .fe-footer--{{ sid }} {
    position: relative;
    font-family: "Plus Jakarta Sans", sans-serif;
    padding: {{ footer_pad_top }}px 20px {{ footer_pad_bottom }}px;
    background: var(--fe-footer-bg, #302313);
    box-sizing: border-box;
  }

  .fe-footer--{{ sid }} *,
  .fe-footer--{{ sid }} *::before,
  .fe-footer--{{ sid }} *::after {
    box-sizing: border-box;
  }

  .fe-footer--{{ sid }} .fe-footer__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .fe-footer--{{ sid }} .fe-footer__backdrop-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .fe-footer--{{ sid }} .fe-footer__backdrop-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fe-footer--{{ sid }} .fe-footer__inner {
    position: relative;
    z-index: 1;
    max-width: 1350px;
    margin: 0 auto;
  }

  .fe-footer--{{ sid }} .fe-footer__logo-row {
    width: 100%;
    margin-bottom: 56px;
  }

  .fe-footer--{{ sid }} .fe-footer__logo-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: 56px;
  }

  .fe-footer--{{ sid }} .fe-footer__align-left {
    text-align: left;
    justify-content: flex-start;
  }
  .fe-footer--{{ sid }} .fe-footer__align-left.fe-footer__logo-row,
  .fe-footer--{{ sid }} .fe-footer__block--logo.fe-footer__align-left {
    display: flex;
    justify-content: flex-start;
  }

  .fe-footer--{{ sid }} .fe-footer__align-center {
    text-align: center;
    justify-content: center;
  }
  .fe-footer--{{ sid }} .fe-footer__logo-row.fe-footer__align-center,
  .fe-footer--{{ sid }} .fe-footer__block--logo.fe-footer__align-center {
    display: flex;
    justify-content: center;
  }

  .fe-footer--{{ sid }} .fe-footer__align-right {
    text-align: right;
    justify-content: flex-end;
  }
  .fe-footer--{{ sid }} .fe-footer__logo-row.fe-footer__align-right,
  .fe-footer--{{ sid }} .fe-footer__block--logo.fe-footer__align-right {
    display: flex;
    justify-content: flex-end;
  }

  .fe-footer--{{ sid }} .fe-footer__logo-link {
    display: inline-block;
    line-height: 0;
  }

  .fe-footer--{{ sid }} .fe-footer__logo {
    max-width: 100%;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .fe-footer--{{ sid }} .fe-footer__logo-svg {
    max-width: 100%;
    margin-inline: auto;
    color: #fff;
  }
  .fe-footer--{{ sid }} .fe-footer__align-left .fe-footer__logo-svg { margin-inline: 0 auto; }
  .fe-footer--{{ sid }} .fe-footer__align-right .fe-footer__logo-svg { margin-inline: auto 0; }

  .fe-footer--{{ sid }} .fe-footer__logo-svg svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .fe-footer--{{ sid }} .fe-footer__grid {
