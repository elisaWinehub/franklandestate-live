{%- liquid
  assign sid = section.id
  assign cil_scope = 'fe-alt-content--' | append: sid
  assign image_position = section.settings.image_position | default: 'image_left'
  assign position_class = 'image-left'
  if image_position == 'right' or image_position == 'image_right' or image_position == 'image-right' or image_position == 'text_left_image_right' or image_position == 'text-left-image-right'
    assign position_class = 'image-right'
  endif
  assign content_font_size = section.settings.content_font_size | default: 16
  assign heading_fs_max = section.settings.heading_font_size | default: 44
  assign heading_fs_min = heading_fs_max | minus: 16
  if heading_fs_min < 20
    assign heading_fs_min = 20
  endif
  assign enable_read_more = section.settings.enable_read_more
  assign read_more_visible_html = ''
  assign read_more_hidden_html = ''
  assign read_more_show_toggle = false
  if enable_read_more and section.settings.body != blank
    assign rm_parts = section.settings.body | split: '</p>'
    assign rm_p_idx = 0
    for rm_part in rm_parts
      assign rm_chunk = rm_part | strip
      if rm_chunk == blank
        continue
      endif
      assign rm_p_idx = rm_p_idx | plus: 1
      assign rm_piece = rm_chunk | append: '</p>'
      if rm_p_idx <= 2
        assign read_more_visible_html = read_more_visible_html | append: rm_piece
      else
        assign read_more_hidden_html = read_more_hidden_html | append: rm_piece
      endif
    endfor
    if read_more_hidden_html != blank
      assign read_more_show_toggle = true
    endif
  endif
-%}

<section
  {% if section.settings.section_anchor_id != blank %}id="{{ section.settings.section_anchor_id | handleize }}"{% endif %}
  class="fe-alt-content fe-alt-content--{{ sid }} fe-alt-content--{{ sid }}--{{ position_class }}"
>
  <div class="fe-alt-content__inner">
    <div class="fe-alt-content__surface{% if section.settings.show_border_top %} fe-alt-content__surface--border-top{% endif %}{% if section.settings.show_border_bottom %} fe-alt-content__surface--border-bottom{% endif %}">
      <div class="fe-alt-content__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1800 }}"
          srcset="
            {{ section.settings.image | image_url: width: 700 }} 700w,
            {{ section.settings.image | image_url: width: 1100 }} 1100w,
            {{ section.settings.image | image_url: width: 1600 }} 1600w
          "
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
          class="fe-alt-content__img"
          loading="lazy"
        >
      {%- else -%}
        <div class="fe-alt-content__img fe-alt-content__img--placeholder" aria-hidden="true"></div>
      {%- endif -%}
      </div>

      <div class="fe-alt-content__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="fe-alt-content__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        {%- if read_more_show_toggle -%}
          <div
            class="fe-alt-content__body fe-alt-content__body--readmore"
            data-fe-readmore-root
            data-expanded="false"
          >
            <div class="fe-alt-content__readmore-viewport" data-fe-readmore-viewport>
              <div class="fe-alt-content__readmore-inner" data-fe-readmore-inner>
                <div class="fe-alt-content__readmore-visible rte" data-fe-readmore-visible>{{ read_more_visible_html }}</div>
                <div
                  class="fe-alt-content__readmore-extra rte"
                  data-fe-readmore-extra
                  hidden
                  aria-hidden="true"
                >
                  {{ read_more_hidden_html }}
                </div>
              </div>
            </div>
            <button
              type="button"
              class="fe-alt-content__readmore-toggle"
              data-fe-readmore-toggle
              aria-expanded="false"
              data-label-more="{{ section.settings.read_more_label | escape }}"
              data-label-less="{{ section.settings.read_less_label | escape }}"
            >
              {{ section.settings.read_more_label | escape }}
            </button>
          </div>
        {%- else -%}
          <div class="fe-alt-content__body rte">{{ section.settings.body }}</div>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="fe-alt-content__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'contact_info_list' -%}
          {% render 'fe-contact-info-list', block: block, scope_class: cil_scope %}
        {%- endif -%}
      {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  .fe-alt-content--{{ sid }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__inner {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    width: 100%;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__inner::before,
  .fe-alt-content--{{ sid }} .fe-alt-content__inner::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(48, 35, 19, 0.16);
    pointer-events: none;
    opacity: 0;
    z-index: 1;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__inner::before {
    top: 0;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__inner::after {
    bottom: 0;
  }

  {%- if section.settings.divider_position == 'top' or section.settings.divider_position == 'both' -%}
    .fe-alt-content--{{ sid }} .fe-alt-content__inner::before { opacity: 1; }
  {%- endif -%}

  {%- if section.settings.divider_position == 'bottom' or section.settings.divider_position == 'both' -%}
    .fe-alt-content--{{ sid }} .fe-alt-content__inner::after { opacity: 1; }
  {%- endif -%}

  .fe-alt-content--{{ sid }} .fe-alt-content__surface {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    box-sizing: border-box;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__surface--border-top.fe-alt-content__surface--border-bottom {
    box-shadow: inset 0 1px 0 0 {{ section.settings.border_color }}, inset 0 -1px 0 0 {{ section.settings.border_color }};
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__surface--border-top:not(.fe-alt-content__surface--border-bottom) {
    box-shadow: inset 0 1px 0 0 {{ section.settings.border_color }};
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__surface--border-bottom:not(.fe-alt-content__surface--border-top) {
    box-shadow: inset 0 -1px 0 0 {{ section.settings.border_color }};
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__surface--border-top,
  .fe-alt-content--{{ sid }} .fe-alt-content__surface--border-bottom {
    padding-top: clamp(28px, 5vw, 40px);
    padding-bottom: clamp(28px, 5vw, 40px);
  }

  .fe-alt-content--{{ sid }}--image-left .fe-alt-content__media {
    order: 1;
  }

  .fe-alt-content--{{ sid }}--image-left .fe-alt-content__text {
    order: 2;
  }

  .fe-alt-content--{{ sid }}--image-right .fe-alt-content__media {
    order: 2;
  }

  .fe-alt-content--{{ sid }}--image-right .fe-alt-content__text {
    order: 1;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__media {
    width: 100%;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    background: #d7d3cd;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__img--placeholder {
    min-height: 240px;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    min-width: 0;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__heading {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp({{ heading_fs_min }}px, 3.2vw, {{ heading_fs_max }}px);
    line-height: 1.14;
    font-weight: 400;
    color: #302313;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__body {
    margin: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    line-height: 1.62;
    color: rgba(48, 35, 19, 0.9);
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__body p,
  .fe-alt-content--{{ sid }} .fe-alt-content__body ul,
  .fe-alt-content--{{ sid }} .fe-alt-content__body ol,
  .fe-alt-content--{{ sid }} .fe-alt-content__body li,
  .fe-alt-content--{{ sid }} .fe-alt-content__body blockquote,
  .fe-alt-content--{{ sid }} .fe-alt-content__body td,
  .fe-alt-content--{{ sid }} .fe-alt-content__body th,
  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore .rte p,
  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore .rte ul,
  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore .rte ol,
  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore .rte li,
  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore .rte blockquote,
  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore .rte td,
  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore .rte th {
    font-size: {{ content_font_size }}px;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__body p {
    margin: 0;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__body p + p {
    margin-top: 12px;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__body--readmore {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    width: 100%;
    min-width: 0;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-viewport {
    overflow: hidden;
    width: 100%;
    transition: height 0.45s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .fe-alt-content--{{ sid }} .fe-alt-content__readmore-viewport {
      transition: none;
    }
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-inner {
    width: 100%;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-visible p,
  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-extra p {
    margin: 0;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-visible p + p,
  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-extra p + p {
    margin-top: 12px;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-extra:not([hidden]) {
    margin-top: 12px;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-toggle {
    margin-top: 14px;
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: {{ content_font_size }}px;
    line-height: 1.5;
    color: rgba(48, 35, 19, 0.88);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    letter-spacing: 0.02em;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-toggle:hover {
    opacity: 0.72;
    color: #302313;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__readmore-toggle:focus-visible {
    outline: 2px solid rgba(48, 35, 19, 0.35);
    outline-offset: 3px;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__button {
    margin-top: 6px;
    align-self: flex-start;
    display: inline-block;
    border: 1px solid #302313;
    color: #302313;
    text-decoration: none;
    font-family: Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 11px 22px;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .fe-alt-content--{{ sid }} .fe-alt-content__button:hover {
    background: #302313;
    color: #fff;
  }

  @media (max-width: 989px) {
    .fe-alt-content--{{ sid }} .fe-alt-content__surface {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    /* Mobile default: image above text regardless of desktop direction */
    .fe-alt-content--{{ sid }} .fe-alt-content__media {
      order: 1 !important;
    }

    .fe-alt-content--{{ sid }} .fe-alt-content__text {
      order: 2 !important;
    }
  }
</style>

{%- if read_more_show_toggle -%}
<script>
  (function () {
    var sectionEl = document.querySelector('.fe-alt-content--{{ sid }}');
    if (!sectionEl) return;
    var root = sectionEl.querySelector('[data-fe-readmore-root]');
    if (!root || root.dataset.feReadmoreInit === '1') return;
    root.dataset.feReadmoreInit = '1';

    var viewport = root.querySelector('[data-fe-readmore-viewport]');
    var inner = root.querySelector('[data-fe-readmore-inner]');
    var visible = root.querySelector('[data-fe-readmore-visible]');
    var extra = root.querySelector('[data-fe-readmore-extra]');
    var btn = root.querySelector('[data-fe-readmore-toggle]');
    if (!viewport || !inner || !visible || !extra || !btn) return;

    var moreLabel = btn.getAttribute('data-label-more') || 'Read More';
    var lessLabel = btn.getAttribute('data-label-less') || 'Read Less';
    var expanded = false;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function syncHeight() {
      var h = expanded ? inner.scrollHeight : visible.scrollHeight;
      viewport.style.height = Math.ceil(h) + 'px';
    }

    function applyExpanded(next) {
      expanded = next;
      root.dataset.expanded = expanded ? 'true' : 'false';
      btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      btn.textContent = expanded ? lessLabel : moreLabel;

      if (expanded) {
        extra.removeAttribute('hidden');
        extra.setAttribute('aria-hidden', 'false');
        requestAnimationFrame(syncHeight);
        return;
      }

      extra.setAttribute('aria-hidden', 'true');

      function finishHide() {
        extra.setAttribute('hidden', '');
      }

      requestAnimationFrame(function () {
        syncHeight();
        if (reduceMotion) {
          finishHide();
          return;
        }
        var done = false;
        function onHeightDone(e) {
          if (e.target !== viewport || e.propertyName !== 'height') return;
          done = true;
          viewport.removeEventListener('transitionend', onHeightDone);
          finishHide();
        }
        viewport.addEventListener('transitionend', onHeightDone);
        window.setTimeout(function () {
          if (!done) {
            viewport.removeEventListener('transitionend', onHeightDone);
            finishHide();
          }
        }, 600);
      });
    }

    extra.setAttribute('hidden', '');
    syncHeight();

    btn.addEventListener('click', function () {
      applyExpanded(!expanded);
    });

    window.addEventListener(
      'resize',
      function () {
        syncHeight();
      },
      { passive: true }
    );
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Alternating Content",
  "tag": "section",
  "class": "fe-alternating-content-section",
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section HTML id (optional)",
      "info": "For anchor links, e.g. intro — no spaces."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 44,
      "info": "Maximum size on large screens; scales down with viewport width."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Content"
    },
    {
      "type": "checkbox",
      "id": "enable_read_more",
      "label": "Enable Read More",
      "default": false
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read More Label",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "read_less_label",
      "label": "Read Less Label",
      "default": "Read Less"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "image_left",
      "options": [
        { "value": "image_left", "label": "Image left / text right" },
        { "value": "image_right", "label": "Text left / image right" }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EFEEE9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#D3D2CB"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "label": "Content font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "divider_position",
      "label": "Divider line",
      "default": "none",
