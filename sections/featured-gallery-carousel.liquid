{%- liquid
  assign sid = section.id
  assign slide_count = 0
  for block in section.blocks
    if block.type == 'slide'
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  assign overlay_op = section.settings.overlay_opacity | times: 1.0 | divided_by: 100.0
  assign show_btn = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_btn = true
  endif
  assign enable_lightbox = section.settings.enable_lightbox
  if enable_lightbox == nil
    assign enable_lightbox = true
  endif
-%}

<section
  id="{{ section.settings.section_id | default: 'featured-gallery' | handleize }}"
  class="fe-featured-gallery fe-featured-gallery--{{ sid }}"
  data-fe-fgc="{{ sid }}"
  style="
    --fe-fgc-bg: {{ section.settings.background_color }};
    --fe-fgc-text: {{ section.settings.text_color }};
    --fe-fgc-accent: {{ section.settings.accent_color }};
    --fe-fgc-divider: {{ section.settings.divider_color }};
    --fe-fgc-container: {{ section.settings.container_width }}px;
    --fe-fgc-carousel-max: {{ section.settings.carousel_max_width }}px;
    --fe-fgc-main-w: {{ section.settings.main_image_width }}px;
    --fe-fgc-side-w: {{ section.settings.side_image_width }}px;
    --fe-fgc-h-desktop: {{ section.settings.image_height_desktop }}px;
    --fe-fgc-h-mobile: {{ section.settings.image_height_mobile }}px;
    --fe-fgc-overlay: {{ overlay_op }};
    --fe-fgc-radius: {{ section.settings.image_border_radius }}px;
    --fe-fgc-gap: 24px;
    --fe-fgc-btn-text: {{ section.settings.button_text_color }};
    --fe-fgc-btn-border: {{ section.settings.button_border_color }};
    --fe-fgc-btn-bg: {{ section.settings.button_background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  {% if section.settings.enable_autoplay and slide_count > 1 %}
    data-fe-fgc-autoplay="1"
    data-fe-fgc-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  {% endif %}
>
  <div class="fe-featured-gallery__inner">
    <header class="fe-featured-gallery__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fe-featured-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="fe-featured-gallery__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <span class="fe-featured-gallery__divider" aria-hidden="true"></span>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="fe-featured-gallery__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </header>

    {%- if slide_count > 0 -%}
      <div
        class="fe-featured-gallery__carousel"
        id="fe-fgc-carousel-{{ sid }}"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading | default: 'Gallery' | escape }}"
      >
        <div class="fe-featured-gallery__carousel-shell">
          <div class="fe-featured-gallery__viewport" data-fe-fgc-viewport>
            <div class="fe-featured-gallery__track" data-fe-fgc-track>
              {%- assign si = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'slide' -%}
                  {%- liquid
                    assign slide_alt = block.settings.alt | default: block.settings.title | default: section.settings.heading
                    assign slide_link = block.settings.link
                    assign is_first = false
                    if si == 0
                      assign is_first = true
                    endif
                  -%}
                  <article
                    class="fe-featured-gallery__slide{% if is_first %} is-active{% endif %}"
                    data-fe-fgc-slide
                    data-index="{{ si }}"
                    id="fe-fgc-slide-{{ sid }}-{{ si }}"
                    {% if enable_lightbox and block.settings.image != blank %}
                      data-fe-fgc-lightbox-src="{{ block.settings.image | image_url: width: 2400 }}"
                      data-fe-fgc-lightbox-title="{{ block.settings.title | escape }}"
                      data-fe-fgc-lightbox-subtitle="{{ block.settings.subtitle | escape }}"
                    {% endif %}
                    {% if slide_count > 1 %}role="group" aria-roledescription="slide" aria-label="{{ si | plus: 1 }} of {{ slide_count }}"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {%- if slide_link != blank and enable_lightbox == false -%}
                      <a class="fe-featured-gallery__card fe-featured-gallery__card--linked" href="{{ slide_link }}">
                    {%- else -%}
                      <div
                        class="fe-featured-gallery__card{% if enable_lightbox and block.settings.image != blank %} fe-featured-gallery__card--lightbox{% endif %}"
                        {% if enable_lightbox and block.settings.image != blank %}
                          data-fe-fgc-lightbox-trigger
                          role="button"
                          tabindex="0"
                          aria-label="{{ 'products.product.media.open_media' | t | default: 'View enlarged image' | escape }}"
                        {% endif %}
                      >
                    {%- endif -%}
                      <div class="fe-featured-gallery__media">
                        {%- if block.settings.image != blank -%}
                          <img
                            class="fe-featured-gallery__img"
                            src="{{ block.settings.image | image_url: width: 1200 }}"
                            srcset="
                              {{ block.settings.image | image_url: width: 400 }} 400w,
                              {{ block.settings.image | image_url: width: 700 }} 700w,
                              {{ block.settings.image | image_url: width: 1000 }} 1000w,
                              {{ block.settings.image | image_url: width: 1200 }} 1200w
                            "
                            sizes="(max-width: 749px) 100vw, {{ section.settings.main_image_width }}px"
                            alt="{{ slide_alt | escape }}"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                            loading="{% if is_first %}eager{% else %}lazy{% endif %}"
                          >
                        {%- else -%}
                          <div class="fe-featured-gallery__img fe-featured-gallery__img--placeholder" aria-hidden="true"></div>
                        {%- endif -%}
                        <div class="fe-featured-gallery__overlay" aria-hidden="true"></div>
                        {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
                          <div class="fe-featured-gallery__caption">
                            {%- if block.settings.title != blank -%}
                              <p class="fe-featured-gallery__caption-title">{{ block.settings.title | escape }}</p>
                            {%- endif -%}
                            {%- if block.settings.subtitle != blank -%}
                              <p class="fe-featured-gallery__caption-sub">{{ block.settings.subtitle | escape }}</p>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- if slide_link != blank and enable_lightbox == false -%}
                      </a>
                    {%- else -%}
                      </div>
                    {%- endif -%}
                  </article>
                  {%- assign si = si | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if slide_count > 1 -%}
            <button
              type="button"
              class="fe-featured-gallery__arrow fe-featured-gallery__arrow--prev"
              data-fe-fgc-prev
              aria-controls="fe-fgc-carousel-{{ sid }}"
              aria-label="{{ 'general.pagination.previous' | t | default: 'Previous slide' }}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              type="button"
              class="fe-featured-gallery__arrow fe-featured-gallery__arrow--next"
              data-fe-fgc-next
              aria-controls="fe-fgc-carousel-{{ sid }}"
              aria-label="{{ 'general.pagination.next' | t | default: 'Next slide' }}"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          {%- endif -%}
        </div>

        {%- if slide_count > 1 -%}
          <div class="fe-featured-gallery__dots" role="tablist" aria-label="{{ 'general.slider.slideshow' | t | default: 'Slide navigation' }}">
            {%- assign dot_i = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'slide' -%}
                <button
                  type="button"
                  class="fe-featured-gallery__dot{% if dot_i == 0 %} is-active{% endif %}"
                  data-fe-fgc-dot="{{ dot_i }}"
                  role="tab"
                  aria-selected="{% if dot_i == 0 %}true{% else %}false{% endif %}"
                  aria-controls="fe-fgc-slide-{{ sid }}-{{ dot_i }}"
                  aria-label="{{ 'general.slider.load_slide' | t | default: 'Go to slide' }} {{ dot_i | plus: 1 }}"
                ></button>
                {%- assign dot_i = dot_i | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if enable_lightbox and slide_count > 0 -%}
        <div class="fe-featured-gallery__modal" hidden data-fe-fgc-modal aria-hidden="true">
          <div class="fe-featured-gallery__modal-overlay" data-fe-fgc-modal-close tabindex="-1"></div>
          <div
            class="fe-featured-gallery__modal-dialog"
            role="dialog"
            aria-modal="true"
            aria-label="{{ section.settings.heading | default: 'Gallery' | escape }}"
          >
            <button
              type="button"
              class="fe-featured-gallery__modal-close"
              data-fe-fgc-modal-close
              aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
            </button>

            {%- if slide_count > 1 -%}
              <button
                type="button"
                class="fe-featured-gallery__modal-arrow fe-featured-gallery__modal-arrow--prev"
                data-fe-fgc-modal-prev
                aria-label="{{ 'general.pagination.previous' | t | default: 'Previous image' }}"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button
                type="button"
                class="fe-featured-gallery__modal-arrow fe-featured-gallery__modal-arrow--next"
                data-fe-fgc-modal-next
                aria-label="{{ 'general.pagination.next' | t | default: 'Next image' }}"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- endif -%}

            <div class="fe-featured-gallery__modal-stage" data-fe-fgc-modal-stage>
              <div class="fe-featured-gallery__modal-loader" data-fe-fgc-modal-loader aria-hidden="true">
                <span class="fe-featured-gallery__modal-spinner"></span>
              </div>
              <img class="fe-featured-gallery__modal-img" data-fe-fgc-modal-img alt="">
              <div class="fe-featured-gallery__modal-overlay-caption" aria-hidden="true"></div>
              <div class="fe-featured-gallery__modal-caption" data-fe-fgc-modal-caption>
                <p class="fe-featured-gallery__modal-caption-title" data-fe-fgc-modal-title></p>
                <p class="fe-featured-gallery__modal-caption-sub" data-fe-fgc-modal-subtitle></p>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if show_btn -%}
      <div class="fe-featured-gallery__cta">
        <a
          class="fe-featured-gallery__btn fe-featured-gallery__btn--{{ section.settings.button_style }}"
          href="{{ section.settings.button_link }}"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .fe-featured-gallery--{{ sid }} {
    width: 100%;
    background-color: var(--fe-fgc-bg);
    color: var(--fe-fgc-text);
    box-sizing: border-box;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__inner {
    max-width: var(--fe-fgc-container);
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__intro {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__eyebrow {
    margin: 0 0 12px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--fe-fgc-accent);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__heading {
    margin: 0;
    font-family: eidetic-neo, Georgia, "Times New Roman", serif;
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 400;
    line-height: 1.12;
    color: var(--fe-fgc-text);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__divider {
    display: block;
    width: 56px;
    height: 1px;
    margin: 18px auto 20px;
    background: var(--fe-fgc-divider);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__description {
    margin: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: var(--fe-fgc-text);
    opacity: 0.9;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__description p {
    margin: 0;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__description p + p {
    margin-top: 12px;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__carousel {
    max-width: var(--fe-fgc-carousel-max);
    margin: 0 auto;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__carousel-shell {
    position: relative;
    width: 100%;
    max-width: calc(var(--fe-fgc-side-w) * 2 + var(--fe-fgc-main-w) + var(--fe-fgc-gap) * 2);
    margin: 0 auto;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__viewport {
    overflow: hidden;
    width: 100%;
    margin: 0 auto;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__track {
    display: flex;
    align-items: stretch;
    gap: var(--fe-fgc-gap);
    will-change: transform;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .fe-featured-gallery--{{ sid }} .fe-featured-gallery__track {
      transition: none;
    }
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__slide {
    flex: 0 0 auto;
    width: var(--fe-fgc-side-w);
    transition: width 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.35s ease;
    opacity: 0.72;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__slide.is-active {
    width: var(--fe-fgc-main-w);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .fe-featured-gallery--{{ sid }} .fe-featured-gallery__slide {
      transition: none;
    }
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__card,
  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__card--linked {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__media {
    position: relative;
    width: 100%;
    height: var(--fe-fgc-h-desktop);
    border-radius: var(--fe-fgc-radius);
    overflow: hidden;
    background: #d8d6cf;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__img--placeholder {
    background: linear-gradient(135deg, #d8d6cf 0%, #c5c2b8 100%);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, var(--fe-fgc-overlay)) 0%, rgba(0, 0, 0, 0) 58%);
    pointer-events: none;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 22px 24px 20px;
    z-index: 1;
    pointer-events: none;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__caption-title {
    margin: 0;
    font-family: eidetic-neo, Georgia, "Times New Roman", serif;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__caption-sub {
    margin: 6px 0 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__slide:not(.is-active) .fe-featured-gallery__caption {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__slide.is-active .fe-featured-gallery__caption {
    opacity: 1;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #fff;
    color: #1a1a1a;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__arrow:hover {
    transform: translateY(-50%) scale(1.04);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.16);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__arrow:focus-visible {
    outline: 2px solid var(--fe-fgc-accent);
    outline-offset: 2px;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__arrow--prev {
    left: calc(var(--fe-fgc-side-w) / 2 - 22px);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__arrow--next {
    right: calc(var(--fe-fgc-side-w) / 2 - 22px);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #d3d2cb;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__dot.is-active {
    background: var(--fe-fgc-accent);
    transform: scale(1.15);
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__dot:focus-visible {
    outline: 2px solid var(--fe-fgc-accent);
    outline-offset: 3px;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__card--lightbox {
    cursor: zoom-in;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__card--lightbox:focus-visible {
    outline: 2px solid var(--fe-fgc-accent);
    outline-offset: 3px;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.32s ease, visibility 0.32s ease;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal[hidden] {
    display: none !important;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.32s ease;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal.is-open .fe-featured-gallery__modal-overlay {
    opacity: 1;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal-dialog {
    position: relative;
    z-index: 1;
    width: min(100%, 1100px);
    max-height: calc(100vh - 48px);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: scale(0.97) translateY(8px);
    opacity: 0;
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.38s ease;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal.is-open .fe-featured-gallery__modal-dialog {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal-stage {
    position: relative;
    width: 100%;
    max-height: calc(100vh - 48px);
    min-height: 200px;
    border-radius: var(--fe-fgc-radius);
    overflow: hidden;
    background: #111;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal-loader {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(17, 17, 17, 0.5);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .fe-featured-gallery--{{ sid }} .fe-featured-gallery__modal-stage.is-loading .fe-featured-gallery__modal-loader {
    opacity: 1;
    visibility: visible;
  }

