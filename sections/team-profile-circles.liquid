{%- liquid
  assign sid = section.id
-%}

<section class="fe-team fe-team--{{ sid }}" id="fe-team-{{ sid }}">
  <div class="fe-team__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="fe-team__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <div class="fe-team__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="fe-team__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign modal_id = 'fe-team-modal-' | append: sid | append: '-' | append: block.id
          assign title_id = modal_id | append: '-title'
          assign bio_id = modal_id | append: '-bio'
          assign open_label = 'Open profile'
          assign profile_name = block.settings.name
          if profile_name == blank
            assign profile_name = 'Team Member'
          endif
          if block.settings.name != blank
            assign open_label = 'Open profile for ' | append: block.settings.name
          endif
          assign image_alt = block.settings.image_alt
          if image_alt == blank
            assign image_alt = profile_name
          endif
        -%}

        <div class="fe-team__item" role="listitem" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="fe-team__profile-btn"
            aria-label="{{ open_label | escape }}"
            aria-controls="{{ modal_id }}"
            data-team-open="{{ modal_id }}"
          >
            <span class="fe-team__avatar-wrap">
              {%- if block.settings.profile_image != blank -%}
                <img
                  class="fe-team__avatar"
                  src="{{ block.settings.profile_image | image_url: width: 500 }}"
                  srcset="
                    {{ block.settings.profile_image | image_url: width: 220 }} 220w,
                    {{ block.settings.profile_image | image_url: width: 360 }} 360w,
                    {{ block.settings.profile_image | image_url: width: 500 }} 500w
                  "
                  sizes="(max-width: 749px) 42vw, (max-width: 989px) 30vw, 220px"
                  alt="{{ image_alt | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <span class="fe-team__avatar fe-team__avatar--placeholder" aria-hidden="true">Photo</span>
              {%- endif -%}
            </span>

            <span class="fe-team__name">{{ profile_name | escape }}</span>
          </button>
        </div>

        <div
          id="{{ modal_id }}"
          class="fe-team__modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="{{ title_id }}"
          aria-describedby="{{ bio_id }}"
          hidden
        >
          <div class="fe-team__modal-overlay" data-team-close="{{ modal_id }}"></div>
          <div class="fe-team__modal-card" tabindex="-1">
            <div class="fe-team__modal-strip">
              <button
                type="button"
                class="fe-team__modal-close"
                aria-label="Close profile"
                data-team-close="{{ modal_id }}"
              >
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>

            <div class="fe-team__modal-avatar-row">
              <div class="fe-team__modal-avatar-inner">
                {%- if block.settings.profile_image != blank -%}
                  <img
                    class="fe-team__modal-avatar"
                    src="{{ block.settings.profile_image | image_url: width: 500 }}"
                    alt="{{ image_alt | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="fe-team__modal-avatar fe-team__modal-avatar--placeholder" aria-hidden="true">Photo</span>
                {%- endif -%}
              </div>
            </div>

            <div class="fe-team__modal-body">
              <h3 id="{{ title_id }}" class="fe-team__modal-name">
                {{ profile_name | escape }}
              </h3>

              {%- if block.settings.role != blank -%}
                <p class="fe-team__modal-role">{{ block.settings.role | escape }}</p>
              {%- endif -%}

              <hr class="fe-team__modal-divider">

              <div id="{{ bio_id }}" class="fe-team__modal-bio rte">
                {%- if block.settings.bio != blank -%}
                  {{ block.settings.bio }}
                {%- else -%}
                  <p>Short profile bio goes here. Share the team member's story, role, and connection to the estate.</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .fe-team--{{ sid }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .fe-team--{{ sid }} .fe-team__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    text-align: center;
  }

  .fe-team--{{ sid }} .fe-team__heading {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.14;
    color: {{ section.settings.text_color }};
  }

  .fe-team--{{ sid }} .fe-team__intro {
    margin: 14px auto 0;
    max-width: 820px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: clamp(14px, 1.4vw, 18px);
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.9;
  }

  .fe-team--{{ sid }} .fe-team__grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 34px 30px;
    justify-items: center;
  }

  .fe-team--{{ sid }} .fe-team__item {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .fe-team--{{ sid }} .fe-team__profile-btn {
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    text-align: center;
    color: inherit;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: min(100%, calc({{ section.settings.image_size }}px + 30px));
  }

  .fe-team--{{ sid }} .fe-team__profile-btn:focus-visible {
    outline: 2px solid rgba(48, 35, 19, 0.55);
    outline-offset: 6px;
  }

  .fe-team--{{ sid }} .fe-team__avatar-wrap {
    width: {{ section.settings.image_size }}px;
    height: {{ section.settings.image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    display: block;
    background: rgba(48, 35, 19, 0.08);
  }

  .fe-team--{{ sid }} .fe-team__avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 50%;
  }

  .fe-team--{{ sid }} .fe-team__avatar--placeholder {
    display: inline-flex;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: rgba(48, 35, 19, 0.12);
    align-items: center;
    justify-content: center;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(48, 35, 19, 0.6);
  }

  .fe-team--{{ sid }} .fe-team__name {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(18px, 1.9vw, 20px);
    line-height: 1.3;
    color: {{ section.settings.text_color }};
  }

  .fe-team--{{ sid }} .fe-team__modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .fe-team--{{ sid }} .fe-team__modal[hidden] {
    display: none;
  }

  .fe-team--{{ sid }} .fe-team__modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.62);
  }

  .fe-team--{{ sid }} .fe-team__modal-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 970px;
    margin: 0;
    color: {{ section.settings.text_color }};
    box-shadow: 0 24px 56px rgba(0, 0, 0, 0.22);
    border-radius: 6px;
    overflow-x: hidden;
    overflow-y: auto;
    background: #ffffff;
    max-height: calc(100vh - 40px);
    box-sizing: border-box;
    --fe-team-modal-photo: 170px;
  }

  .fe-team--{{ sid }} .fe-team__modal-strip {
    height: 158px;
    background: {{ section.settings.modal_background_color }};
    position: relative;
  }

  .fe-team--{{ sid }} .fe-team__modal-close {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: {{ section.settings.text_color }};
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    z-index: 5;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .fe-team--{{ sid }} .fe-team__modal-close:hover {
    background: transparent;
    opacity: 0.72;
  }

  .fe-team--{{ sid }} .fe-team__modal-close:focus-visible {
    outline: 2px solid rgba(48, 35, 19, 0.55);
    outline-offset: 2px;
  }

  .fe-team--{{ sid }} .fe-team__modal-close svg {
    display: block;
  }

  .fe-team--{{ sid }} .fe-team__modal-avatar-row {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--fe-team-modal-photo) / -2);
    margin-bottom: 10px;
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .fe-team--{{ sid }} .fe-team__modal-avatar-inner {
    pointer-events: auto;
    border-radius: 50%;
    box-shadow: 0 0 0 5px #ffffff;
    background: #ffffff;
    line-height: 0;
  }

  .fe-team--{{ sid }} .fe-team__modal-avatar {
    width: var(--fe-team-modal-photo);
    height: var(--fe-team-modal-photo);
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  .fe-team--{{ sid }} .fe-team__modal-avatar--placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(48, 35, 19, 0.1);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(48, 35, 19, 0.55);
  }

  .fe-team--{{ sid }} .fe-team__modal-body {
    background: #ffffff;
    padding: 8px clamp(24px, 5vw, 56px) clamp(36px, 5vw, 56px);
    text-align: center;
  }

  .fe-team--{{ sid }} .fe-team__modal-name {
    margin: 0;
    font-family: eidetic-neo, Georgia, "Times New Roman", serif;
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 400;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
  }

  .fe-team--{{ sid }} .fe-team__modal-role {
    margin: 12px 0 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    opacity: 0.72;
  }

  .fe-team--{{ sid }} .fe-team__modal-divider {
    width: 100%;
    max-width: 720px;
    height: 1px;
    margin: 22px auto 24px;
    border: 0;
    background: {{ section.settings.divider_color }};
  }

  .fe-team--{{ sid }} .fe-team__modal-bio {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: {{ section.settings.text_color }};
    max-width: 720px;
    margin: 0 auto;
    text-align: left;
  }

  .fe-team--{{ sid }} .fe-team__modal-bio p {
    margin: 0;
  }

  .fe-team--{{ sid }} .fe-team__modal-bio p + p {
    margin-top: 12px;
  }

  body.fe-team-modal-open {
    overflow: hidden;
  }

  @media (max-width: 989px) {
    .fe-team--{{ sid }} .fe-team__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .fe-team--{{ sid }} .fe-team__modal-card {
      --fe-team-modal-photo: 148px;
      border-radius: 4px;
    }

    .fe-team--{{ sid }} .fe-team__modal-strip {
      height: 140px;
    }

    .fe-team--{{ sid }} .fe-team__modal-body {
      padding-bottom: 36px;
    }

    .fe-team--{{ sid }} .fe-team__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 18px;
    }

    .fe-team--{{ sid }} .fe-team__avatar-wrap {
      width: min(42vw, {{ section.settings.image_size }}px);
      height: min(42vw, {{ section.settings.image_size }}px);
    }
  }

  @media (max-width: 420px) {
    .fe-team--{{ sid }} .fe-team__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('fe-team-{{ sid }}');
    if (!root || root.dataset.teamModalInit === 'true') return;
    root.dataset.teamModalInit = 'true';

    var body = document.body;
    var openButtons = root.querySelectorAll('[data-team-open]');
    var closeButtons = root.querySelectorAll('[data-team-close]');
    var activeModal = null;

    function closeModal() {
      if (!activeModal) return;
      activeModal.setAttribute('hidden', '');
      body.classList.remove('fe-team-modal-open');
      activeModal = null;
    }

    function openModal(modalId) {
      var modal = root.querySelector('#' + CSS.escape(modalId));
      if (!modal) return;
      if (activeModal && activeModal !== modal) {
        activeModal.setAttribute('hidden', '');
      }
      modal.removeAttribute('hidden');
      body.classList.add('fe-team-modal-open');
      activeModal = modal;
      var focusTarget = modal.querySelector('.fe-team__modal-close');
      if (focusTarget) focusTarget.focus();
    }

    openButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var modalId = btn.getAttribute('data-team-open');
        if (modalId) openModal(modalId);
      });
    });

    closeButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        closeModal();
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && activeModal) {
        closeModal();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Team Profile Circles",
  "tag": "section",
  "class": "fe-team-profile-circles-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#efeee9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#302313"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Profile image size",
      "min": 120,
      "max": 260,
      "step": 2,
      "unit": "px",
      "default": 180
    },
    {
      "type": "color",
      "id": "modal_background_color",
      "label": "Modal header background",
      "default": "#e8e8e8",
      "info": "Light grey band behind the top of the profile photo."
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#d8d2c8"
    }
  ],
  "blocks": [
    {
      "type": "profile",
      "name": "Profile",
      "settings": [
        {
          "type": "image_picker",
          "id": "profile_image",
          "label": "Profile image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role (optional)"
        },
        {
          "type": "richtext",
          "id": "bio",
          "label": "Bio"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text (optional)"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Team Profile Circles",
      "blocks": [
        {
          "type": "profile",
          "settings": {
            "name": "Hunter Smith",
            "role": "Winemaker",
            "bio": "<p>Hunter leads our winemaking team with a focus on expressive, site-driven wines shaped by Frankland Estate's unique soils and climate.</p>",
            "image_alt": "Portrait placeholder for Hunter Smith"
          }
        },
        {
          "type": "profile",
          "settings": {
            "name": "Judi Cullam",
            "role": "Founder",
            "bio": "<p>Judi's vision established the foundation of the estate and continues to influence our values of integrity, care, and long-term stewardship.</p>",
            "image_alt": "Portrait placeholder for Judi Cullam"
          }
        },
        {
          "type": "profile",
          "settings": {
            "name": "Barrie Smith",
            "role": "Vineyard Director",
            "bio": "<p>Barrie oversees vineyard operations with a deep commitment to sustainable farming and preserving the health of our Isolation Ridge vines.</p>",
            "image_alt": "Portrait placeholder for Barrie Smith"
          }
        },
        {
          "type": "profile",
          "settings": {
            "name": "Cellar Team",
            "role": "Operations",
            "bio": "<p>Our cellar team ensures every bottle is handled with precision from fermentation through maturation and final release.</p>",
            "image_alt": "Portrait placeholder for cellar team"
          }
        }
      ]
    }
  ]
}
{% endschema %}
