{%- liquid
  assign sid = section.id
  assign fetch_limit = section.settings.products_count | default: 6
  assign visible_count = section.settings.visible_count | default: 4
  assign current_id = product.id
  assign rec_products = nil
  assign rec_count = 0

  if recommendations.performed and recommendations.products_count > 0
    assign rec_products = recommendations.products
  else
    assign fallback_collection = section.settings.collection
    if fallback_collection == blank and product.collections.first
      assign fallback_collection = product.collections.first
    endif
    if fallback_collection != blank
      assign rec_products = fallback_collection.products
    endif
  endif
-%}

{% stylesheet %}
  .fe-product-recs--{{ sid }} {
    background: var(--fe-recs-bg);
    color: var(--fe-recs-text);
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__inner {
    max-width: var(--fe-recs-container);
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__heading {
    margin: 0;
    font-family: eidetic-neo, Georgia, "Times New Roman", serif;
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--fe-recs-text);
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__arrows {
    display: flex;
    gap: 8px;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__arrow {
    appearance: none;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(48, 35, 19, 0.22);
    border-radius: 50%;
    background: transparent;
    color: var(--fe-recs-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__arrow:hover {
    background: rgba(48, 35, 19, 0.06);
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__viewport {
    overflow: hidden;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__track {
    display: flex;
    gap: var(--fe-recs-gap, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__slide {
    flex: 0 0 calc((100% - (var(--fe-recs-gap, 20px) * (var(--fe-recs-visible, 4) - 1))) / var(--fe-recs-visible, 4));
    max-width: calc((100% - (var(--fe-recs-gap, 20px) * (var(--fe-recs-visible, 4) - 1))) / var(--fe-recs-visible, 4));
    min-width: 0;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__card {
    background: rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    overflow: hidden;
    height: 100%;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__img-link {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: #efeee9;
    aspect-ratio: 4 / 5;
    padding: 28px 28px 22px;
    box-sizing: border-box;
    overflow: hidden;
  }

  /*
    After JS trims transparent padding, force every bottle to the same
    visual height (bottom-aligned) regardless of source crop.
  */
  .fe-product-recs--{{ sid }} .fe-product-recs__img {
    width: auto;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: bottom center;
    display: block;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__img.is-normalized,
  .fe-product-recs--{{ sid }} .fe-product-recs__img.is-normalize-fallback {
    opacity: 1;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__img--placeholder {
    width: 58%;
    height: 58%;
    margin: auto;
    opacity: 0.35;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__meta {
    padding: 16px 14px 18px;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__title {
    margin: 0 0 8px;
    font-family: eidetic-neo, Georgia, "Times New Roman", serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__title a {
    color: inherit;
    text-decoration: none;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__title a:hover {
    text-decoration: underline;
  }

  .fe-product-recs--{{ sid }} .fe-product-recs__price {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 989px) {
    .fe-product-recs--{{ sid }} .fe-product-recs__arrows {
      flex-shrink: 0;
    }

    .fe-product-recs--{{ sid }} .fe-product-recs__slide {
      flex: 0 0 calc((100% - var(--fe-recs-gap, 20px)) / 2);
      max-width: calc((100% - var(--fe-recs-gap, 20px)) / 2);
    }
  }

  @media (max-width: 520px) {
    .fe-product-recs--{{ sid }} .fe-product-recs__slide {
      flex: 0 0 100%;
      max-width: 100%;
    }
  }
{% endstylesheet %}


<section
  class="fe-product-recs fe-product-recs--{{ sid }}"
  data-fe-product-recs="{{ sid }}"
  data-fe-recs-visible="{{ visible_count }}"
  data-fe-recs-url="{{ routes.product_recommendations_url }}?section_id={{ sid }}&product_id={{ product.id }}&limit={{ fetch_limit }}&intent=related"
  style="
    --fe-recs-bg: {{ section.settings.background_color }};
    --fe-recs-text: {{ section.settings.text_color }};
    --fe-recs-container: {{ section.settings.container_width }}px;
    --fe-recs-visible: {{ visible_count }};
    --fe-recs-gap: 20px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="fe-product-recs__inner">
    <div class="fe-product-recs__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="fe-product-recs__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.show_arrows -%}
        <div class="fe-product-recs__arrows">
          <button type="button" class="fe-product-recs__arrow" data-fe-recs-prev aria-label="Previous products">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="fe-product-recs__arrow" data-fe-recs-next aria-label="Next products">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="fe-product-recs__viewport" data-fe-recs-viewport>
      <ul class="fe-product-recs__track" data-fe-recs-track role="list">
        {%- if rec_products != blank -%}
          {%- for rec_product in rec_products -%}
            {%- if rec_product.id != current_id -%}
              {%- assign rec_count = rec_count | plus: 1 -%}
              {%- if rec_count <= fetch_limit -%}
                <li class="fe-product-recs__slide">
                  <article class="fe-product-recs__card">
                    <a href="{{ rec_product.url }}" class="fe-product-recs__img-link" tabindex="-1" aria-hidden="true">
                      {%- if rec_product.featured_image != blank -%}
                        <img
                          class="fe-product-recs__img"
                          src="{{ rec_product.featured_image | image_url: width: 600 }}"
                          srcset="
                            {{ rec_product.featured_image | image_url: width: 300 }} 300w,
                            {{ rec_product.featured_image | image_url: width: 450 }} 450w,
                            {{ rec_product.featured_image | image_url: width: 600 }} 600w
                          "
                          sizes="(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw"
                          alt="{{ rec_product.featured_image.alt | escape | default: rec_product.title }}"
                          loading="lazy"
                          decoding="async"
                          crossorigin="anonymous"
                          data-fe-normalize-bottle
                        >
                      {%- else -%}
                        {{ 'product-apparel-1' | placeholder_svg_tag: 'fe-product-recs__img fe-product-recs__img--placeholder' }}
                      {%- endif -%}
                    </a>
                    <div class="fe-product-recs__meta">
                      <h3 class="fe-product-recs__title">
                        <a href="{{ rec_product.url }}">{{ rec_product.title | escape }}</a>
                      </h3>
                      <p class="fe-product-recs__price">{{ rec_product.price | money }}</p>
                    </div>
                  </article>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>


<script>
  (function () {
    var roots = document.querySelectorAll('.fe-product-recs--{{ sid }}[data-fe-product-recs]');
    if (!roots.length) return;

    var ALPHA_THRESHOLD = 10;

    function findOpaqueBounds(imageData, width, height) {
      var data = imageData.data;
      var top = height;
      var bottom = -1;
      var left = width;
      var right = -1;
      var x;
      var y;
      var i;
      var a;

      for (y = 0; y < height; y++) {
        for (x = 0; x < width; x++) {
          a = data[(y * width + x) * 4 + 3];
          if (a > ALPHA_THRESHOLD) {
            if (y < top) top = y;
            if (y > bottom) bottom = y;
            if (x < left) left = x;
            if (x > right) right = x;
          }
        }
      }

      if (bottom < top || right < left) return null;
      return { top: top, right: right, bottom: bottom, left: left };
    }

    function normalizeBottleImage(img) {
      if (!img || img.getAttribute('data-fe-normalized') === '1') return;
      if (!img.naturalWidth || !img.naturalHeight) return;

      var width = img.naturalWidth;
      var height = img.naturalHeight;
      var canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      var ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) {
        img.classList.add('is-normalize-fallback');
        return;
      }

      try {
        ctx.drawImage(img, 0, 0);
        var imageData = ctx.getImageData(0, 0, width, height);
        var bounds = findOpaqueBounds(imageData, width, height);
        if (!bounds) {
          img.classList.add('is-normalize-fallback');
          return;
        }

        var cropW = bounds.right - bounds.left + 1;
        var cropH = bounds.bottom - bounds.top + 1;
        var cropped = document.createElement('canvas');
        cropped.width = cropW;
        cropped.height = cropH;
        cropped.getContext('2d').drawImage(
          canvas,
          bounds.left,
          bounds.top,
          cropW,
          cropH,
          0,
          0,
          cropW,
          cropH
        );

        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        img.setAttribute('data-fe-normalized', '1');
        img.src = cropped.toDataURL('image/png');
        img.classList.add('is-normalized');
      } catch (err) {
        img.classList.add('is-normalize-fallback');
      }
    }

    function normalizeBottles(scope) {
      var imgs = scope.querySelectorAll('img[data-fe-normalize-bottle]');
      Array.prototype.forEach.call(imgs, function (img) {
        if (img.getAttribute('data-fe-normalized') === '1') return;

        var run = function () {
          normalizeBottleImage(img);
        };

        if (img.complete && img.naturalWidth) {
          run();
        } else {
          img.addEventListener('load', run, { once: true });
          img.addEventListener(
            'error',
            function () {
              img.classList.add('is-normalize-fallback');
            },
            { once: true }
          );
        }
      });
    }

    roots.forEach(function (root) {
      if (root.getAttribute('data-fe-recs-init') === '1') return;
      root.setAttribute('data-fe-recs-init', '1');

      var viewport = root.querySelector('[data-fe-recs-viewport]');
      var track = root.querySelector('[data-fe-recs-track]');
      var prevBtn = root.querySelector('[data-fe-recs-prev]');
      var nextBtn = root.querySelector('[data-fe-recs-next]');
      if (!viewport || !track) return;

      var index = 0;
      var gap = 20;
      var visibleDesktop = parseInt(root.getAttribute('data-fe-recs-visible'), 10) || 4;
      var scrollStep = 1;

      function slidesPerView() {
        if (window.innerWidth <= 520) return 1;
        if (window.innerWidth <= 989) return Math.min(2, visibleDesktop);
        return visibleDesktop;
      }

      function getSlideWidth() {
        var spv = slidesPerView();
        var viewportW = viewport.getBoundingClientRect().width;
        return (viewportW - gap * (spv - 1)) / spv;
      }

      function maxIndex() {
        var spv = slidesPerView();
        return Math.max(0, track.children.length - spv);
      }

      function applySlideWidths() {
        var slideW = getSlideWidth();
        Array.prototype.forEach.call(track.children, function (slide) {
          slide.style.width = slideW + 'px';
          slide.style.flexBasis = slideW + 'px';
        });
      }

      function update() {
        applySlideWidths();
        var slideW = getSlideWidth();
        track.style.transform = 'translate3d(' + (-index * (slideW + gap)) + 'px, 0, 0)';

        if (prevBtn) {
          prevBtn.disabled = index <= 0;
          prevBtn.style.opacity = index <= 0 ? '0.4' : '1';
        }
        if (nextBtn) {
          nextBtn.disabled = index >= maxIndex();
          nextBtn.style.opacity = index >= maxIndex() ? '0.4' : '1';
        }
      }

      function initCarousel() {
        index = Math.min(index, maxIndex());
        update();
        normalizeBottles(track);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          index = Math.max(0, index - scrollStep);
          update();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          index = Math.min(maxIndex(), index + scrollStep);
          update();
        });
      }

      window.addEventListener('resize', function () {
        initCarousel();
      });

      var recsUrl = root.getAttribute('data-fe-recs-url');
      if (recsUrl && track.children.length === 0) {
        fetch(recsUrl)
          .then(function (r) {
            if (!r.ok) throw new Error('fetch failed');
            return r.text();
          })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var newTrack = doc.querySelector('[data-fe-recs-track]');
            if (newTrack && newTrack.children.length) {
              track.innerHTML = newTrack.innerHTML;
              index = 0;
            }
          })
          .catch(function () {})
          .finally(function () {
            initCarousel();
          });
      } else {
        initCarousel();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "fe-product-recs-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Total products to load",
      "default": 6,
      "info": "Load more than visible count so the carousel can scroll"
    },
    {
      "type": "range",
      "id": "visible_count",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Products visible (desktop)",
      "default": 4
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection fallback",
      "info": "Used when Shopify recommendations are unavailable"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrow controls",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f9f8f3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#302313"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Container max width",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
