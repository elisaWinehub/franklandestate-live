{%- comment -%}
  Single global Add to Cart confirmation modal (AJAX). Loaded from layout/theme.liquid.
{%- endcomment -%}

<div id="wine-atc-modal-global" class="wine-atc-modal" hidden>
  <div class="wine-atc-modal__overlay" data-modal-overlay></div>
  <div
    class="wine-atc-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="wine-atc-modal-title-global"
  >
    <button type="button" class="wine-atc-modal__close" aria-label="Close" data-modal-close>
      &times;
    </button>

    <div class="wine-atc-modal__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="56" height="56" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="11" fill="#2f7d3a"></circle>
        <path d="M7 12.5L10.2 15.7L17.2 8.8" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>

    <h2 id="wine-atc-modal-title-global" class="wine-atc-modal__title">
      <span data-modal-product-title>Product</span> was added to your cart.
    </h2>
    <p class="wine-atc-modal__count" data-modal-count>
      There is 1 item in your shopping cart.
    </p>

    <div class="wine-atc-modal__actions">
      <a class="wine-atc-modal__action" href="{{ routes.cart_url }}">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 576 512" class="wine-atc-modal__action-icon"><path fill="currentColor" d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"></path></svg>
        <span>View Cart</span>
      </a>
      <button class="wine-atc-modal__action" type="button" data-modal-close>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 512 512" class="wine-atc-modal__action-icon"><path fill="currentColor" d="M128 32l32 0c17.7 0 32 14.3 32 32l0 32L96 96l0-32c0-17.7 14.3-32 32-32zm64 96l0 320c0 17.7-14.3 32-32 32L32 480c-17.7 0-32-14.3-32-32l0-59.1c0-34.6 9.4-68.6 27.2-98.3C40.9 267.8 49.7 242.4 53 216L60.5 156c2-16 15.6-28 31.8-28l99.8 0zm227.8 0c16.1 0 29.8 12 31.8 28L459 216c3.3 26.4 12.1 51.8 25.8 74.6c17.8 29.7 27.2 63.7 27.2 98.3l0 59.1c0 17.7-14.3 32-32 32l-128 0c-17.7 0-32-14.3-32-32l0-320 99.8 0zM320 64c0-17.7 14.3-32 32-32l32 0c17.7 0 32 14.3 32 32l0 32-96 0 0-32zm-32 64l0 160-64 0 0-160 64 0z"></path></svg>
        <span>Continue Shopping</span>
      </button>
      <a class="wine-atc-modal__action" href="/checkout">
        <svg aria-hidden="true" focusable="false" viewBox="0 0 576 512" class="wine-atc-modal__action-icon"><path fill="currentColor" d="M253.3 35.1c6.1-11.8 1.5-26.3-10.2-32.4s-26.3-1.5-32.4 10.2L117.6 192 32 192c-17.7 0-32 14.3-32 32s14.3 32 32 32L83.9 463.5C91 492 116.6 512 146 512L430 512c29.4 0 55-20 62.1-48.5L544 256c17.7 0 32-14.3 32-32s-14.3-32-32-32l-85.6 0L365.3 12.9C359.2 1.2 344.7-3.4 332.9 2.7s-16.3 20.6-10.2 32.4L404.3 192l-232.6 0L253.3 35.1zM192 304l0 96c0 8.8-7.2 16-16 16s-16-7.2-16-16l0-96c0-8.8 7.2-16 16-16s16 7.2 16 16zm96-16c8.8 0 16 7.2 16 16l0 96c0 8.8-7.2 16-16 16s-16-7.2-16-16l0-96c0-8.8 7.2-16 16-16zm128 16l0 96c0 8.8-7.2 16-16 16s-16-7.2-16-16l0-96c0-8.8 7.2-16 16-16s16 7.2 16 16z"></path></svg>
        <span>Checkout</span>
      </a>
    </div>
  </div>
</div>

{% stylesheet %}
  .wine-atc-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    padding: 18px;
  }

  .wine-atc-modal[hidden] {
    display: none;
  }

  .wine-atc-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.22s ease;
  }

  .wine-atc-modal__dialog {
    position: relative;
    width: min(700px, 100%);
    background: #ffffff;
    color: #302313;
    border-radius: 8px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
    transform: translateY(8px) scale(0.98);
    opacity: 0;
    transition: transform 0.22s ease, opacity 0.22s ease;
    overflow: hidden;
  }

  .wine-atc-modal.is-open .wine-atc-modal__overlay {
    opacity: 1;
  }

  .wine-atc-modal.is-open .wine-atc-modal__dialog {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .wine-atc-modal__close {
    position: absolute;
    top: 10px;
    right: 12px;
    border: 0;
    background: transparent;
    color: #302313;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
  }

  .wine-atc-modal__icon {
    display: flex;
    justify-content: center;
    padding-top: 34px;
  }

  .wine-atc-modal__title {
    margin: 18px auto 8px;
    max-width: 80%;
    text-align: center;
    font-family: eidetic-neo, serif;
    font-weight: 500;
    font-size: clamp(1.3rem, 2.3vw, 30px);
    line-height: 1.28;
  }

  .wine-atc-modal__count {
    margin: 0 auto 24px;
    max-width: 80%;
    text-align: center;
    font-size: 15px;
    color: #5a4a36;
  }

  .wine-atc-modal__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #d8d1c7;
  }

  .wine-atc-modal__action {
    appearance: none;
    border: 0;
    border-right: 1px solid #d8d1c7;
    background: #fff;
    color: #302313;
    text-decoration: none;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 12px;
    font-size: 14px;
    cursor: pointer;
  }

  .wine-atc-modal__action-icon {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
  }

  .wine-atc-modal__action:last-child {
    border-right: 0;
  }

  .wine-atc-modal__action:hover {
    background: #f5f1e9;
  }

  @media (max-width: 560px) {
    .wine-atc-modal__title,
    .wine-atc-modal__count {
      max-width: 90%;
    }

    .wine-atc-modal__actions {
      grid-template-columns: 1fr;
    }

    .wine-atc-modal__action {
      border-right: 0;
      border-top: 1px solid #d8d1c7;
    }
  }
{% endstylesheet %}
