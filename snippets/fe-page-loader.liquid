{% comment %}
  Global page navigation / reload spinner.
  Rendered as early as possible in <body> so it covers FOUC while section CSS loads.
{% endcomment %}
<div
  id="fe-page-loader"
  class="fe-page-loader is-visible"
  aria-hidden="false"
  role="status"
  aria-live="polite"
  aria-label="Loading"
>
  <div class="fe-page-loader__panel">
    <span class="fe-page-loader__spinner" aria-hidden="true"></span>
    <span class="fe-page-loader__text">Loading</span>
  </div>
</div>
