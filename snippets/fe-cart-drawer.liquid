{% doc %}
  Frankland header cart drawer.

  Renders the theme cart drawer using the Frankland cart icon as the trigger.

  @param {string} section_id - Section ID used for cart drawer section rendering
{% enddoc %}

{% unless settings.cart_type == 'drawer' and template.name != 'cart' %}
  <a
    href="{{ routes.cart_url }}"
    class="fe-hdr__action-btn"
    aria-label="Cart ({{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }})"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
    </svg>
    <span class="fe-cart-count{% if cart.item_count == 0 %} fe-cart-count--empty{% endif %}" aria-hidden="true">{{ cart.item_count }}</span>
  </a>
{% else %}
  <script
    src="{{ 'cart-drawer.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div class="cart-drawer__header">
      <button
        ref="closeButton"
        on:click="cart-drawer-component/close"
        class="button close-button cart-drawer__close-button button-unstyled"
        aria-label="{{ 'actions.close_dialog' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    <div class="cart-drawer__content" aria-label="{{ 'accessibility.cart' | t }}">
      <h2 class="cart-drawer__heading h4 cart-drawer__heading--empty" id="cart-drawer-heading-empty">
        {{ 'content.your_cart_is_empty' | t }}
      </h2>
      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true %}
      </div>
    </div>
  {% endcapture %}

  <cart-drawer-component
    class="cart-drawer fe-hdr-cart-drawer"
    auto-open
  >
    <template id="empty-cart-template">
      {{ empty_cart_drawer_content }}
    </template>

    <button
      type="button"
      class="fe-hdr__action-btn"
      on:click="/open"
      aria-haspopup="dialog"
      aria-label="Cart ({{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }})"
      data-testid="cart-drawer-trigger"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
      </svg>
      <span class="fe-cart-count{% if cart.item_count == 0 %} fe-cart-count--empty{% endif %}" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
    </button>

    <dialog
      ref="dialog"
      class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{% endif %}"
      data-testid="cart-drawer-dialog"
      aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
      scroll-lock
      cart-summary-sticky="true"
    >
      <span ref="liveRegion" class="visually-hidden" role="status"></span>
      <div class="cart-drawer__inner" data-hydration-key="cart-drawer-inner">
        {% capture cart_items_children %}
          {%- if cart.empty? -%}
            {{ empty_cart_drawer_content }}
          {%- else -%}
            <div class="cart-drawer__header" id="cart-drawer-header">
              <h2 class="cart-drawer__heading h4" id="cart-drawer-heading">
                {{ 'content.cart_title' | t }}
                {% render 'cart-bubble' %}
              </h2>
              <button
                ref="closeButton"
                on:click="cart-drawer-component/close"
                class="button close-button cart-drawer__close-button button-unstyled"
                aria-label="{{ 'actions.close_dialog' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>

            <scroll-hint class="cart-drawer__content" aria-label="{{ 'accessibility.cart' | t }}" style="--header-height: 60px;">
              <scroll-hint class="cart-drawer__items">
                {% render 'cart-products' %}
              </scroll-hint>
              <div class="cart-drawer__summary">
                {% render 'cart-summary', section_id: section_id %}
              </div>
            </scroll-hint>
          {%- endif -%}
        {% endcapture %}
        {% render 'cart-items-component', children: cart_items_children, is_drawer: true, section_id: section_id %}
      </div>
    </dialog>
  </cart-drawer-component>
{% endunless %}

{% stylesheet %}
  .fe-hdr-cart-drawer.cart-drawer {
    --cart-drawer-padding: var(--padding-xl) var(--padding-xl);
    --cart-drawer-padding-desktop: var(--padding-xl) var(--padding-2xl);
    display: contents;
  }

  .fe-hdr-cart-drawer .cart-drawer__dialog {
    position: fixed;
    overflow: hidden;
    border-radius: 0;
    width: 100%;
    height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border-left: var(--style-border-drawer);
    box-shadow: var(--shadow-drawer);
    background-color: var(--color-background);
  }

  @media screen and (min-width: 750px) {
    .fe-hdr-cart-drawer .cart-drawer__dialog {
      width: var(--sidebar-width);
      max-width: 95vw;
    }
  }

  .fe-hdr-cart-drawer .cart-drawer__dialog:modal {
    max-height: 100dvh;
    overflow-y: hidden;
  }

  .fe-hdr-cart-drawer .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .fe-hdr-cart-drawer .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .fe-hdr-cart-drawer .cart-drawer__heading {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    margin-bottom: 0;
  }

  .fe-hdr-cart-drawer .cart-drawer__close-button {
    margin-right: calc(var(--padding-sm) * -1);
    top: var(--margin-sm);
  }

  .fe-hdr-cart-drawer.cart-drawer--empty .cart-drawer__content {
    text-align: center;
    min-height: auto;
    justify-content: center;
  }

  .fe-hdr-cart-drawer .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);
    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
  }

  @media screen and (min-width: 750px) {
    .fe-hdr-cart-drawer .cart-drawer__summary {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .fe-hdr-cart-drawer .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  @media screen and (min-width: 750px) {
    .fe-hdr-cart-drawer .cart-drawer__items {
      padding-inline: var(--cart-drawer-padding-desktop);
    }
  }

  .fe-hdr-cart-drawer .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--cart-drawer-padding);
    position: sticky;
    top: 0;
    z-index: 1;
  }

  @media screen and (min-width: 750px) {
    .fe-hdr-cart-drawer .cart-drawer__header {
      padding-inline: var(--cart-drawer-padding-desktop);
    }
  }

  .fe-hdr-cart-drawer.cart-drawer--empty .cart-drawer__header {
    justify-content: right;
    border-bottom: none;
    padding-bottom: 0;
  }

  .fe-hdr-cart-drawer.cart-drawer--empty .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    margin-top: 0;
  }

  .fe-hdr-cart-drawer .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }
{% endstylesheet %}
